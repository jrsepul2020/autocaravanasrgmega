---
import Base from '../layouts/Base.astro';
import AvailabilityCalendar from '../components/AvailabilityCalendar.astro';
import QuoteForm from '../components/QuoteForm.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { vehicles, fromPrice } from '../data/vehicles';
import PriceNote from '../components/PriceNote.astro';
import Steps from '../components/Steps.astro';
---
<Base
  title="Disponibilidad Autocaravanas de Alquiler en Sevilla · Calendario | RG MEGA"
  description="Consulta en tiempo real las fechas libres de nuestras autocaravanas de alquiler en Sevilla: Benimar Mileo 268 y Camper 120 UP. Selecciona tus días y pide precio al momento."
  breadcrumbs={[{ name: 'Disponibilidad', url: '/calendario-disponibilidad/' }]}
>
  <section class="section" style="padding-top:2rem">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Calendario actualizado</span>
        <h1>Disponibilidad de autocaravanas en Sevilla</h1>
        <p class="lead">Cada día muestra su precio orientativo. Los días en rojo ya están reservados. Pulsa el día de recogida y el de devolución y verás el precio de tu viaje al momento.</p>
        <div class="cal-jump">{vehicles.map((v) => <a class="btn btn--ghost btn--sm" href={`#cal-${v.id}`}>{v.name}</a>)}</div>
      </div>
      {vehicles.map((v) => (
        <div class="cal-veh" id={`cal-${v.id}`}>
          <div class="cal-head">
            <h2><a href={v.slug}>{v.name}</a></h2>
            <span class="pill pill--hot">desde <span data-from={v.id}>{fromPrice(v)}</span> €/día</span>
          </div>
          <AvailabilityCalendar vehicle={v} months={4} summary />
        </div>
      ))}
      <p class="cal-note"><Icon name="calendar" /> El calendario se actualiza a diario. Si una fecha aparece libre pero tienes prisa, confírmala por WhatsApp: respondemos en minutos.</p>
    </div>
  </section>
  <section class="section section--sand">
    <div class="narrow"><QuoteForm title="Pide precio para tus fechas" /></div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <h2>Así de fácil es reservar</h2>
        <p class="lead">Del primer mensaje a la carretera en 4 pasos.</p>
      </div>
      <Steps />
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .cal-veh { margin-top: 2.2rem; scroll-margin-top: 90px; }
  .cal-jump { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1rem; }
  .cal-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .8rem; }
  .cal-head h2 { margin: 0; font-size: 1.5rem; }
  .cal-head a { color: inherit; text-decoration: none; }
  .cal-note { display: flex; gap: .6rem; align-items: flex-start; margin-top: 1.5rem; color: var(--muted); }
  .cal-note :global(svg) { width: 20px; height: 20px; flex: none; margin-top: .2rem; color: var(--terra-ink); }
</style>
