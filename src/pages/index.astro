---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import KeyFacts from '../components/KeyFacts.astro';
import Reviews from '../components/Reviews.astro';
import FaqList from '../components/FaqList.astro';
import Location from '../components/Location.astro';
import CtaBand from '../components/CtaBand.astro';
import { offers, site } from '../data/site';
import { vehicles, getVehicle, fromPrice } from '../data/vehicles';
import { rutas } from '../data/rutas';
import { faqsBy } from '../data/faqs';
import imgBanner from '../assets/img/viaja-a-tu-ritmo.webp';
import imgCadiz from '../assets/img/ruta-camper-costa.webp';
import imgAracena from '../assets/img/escapada-sierra-aracena.webp';
import imgAlgarve from '../assets/img/escapada-algarve.webp';
import imgPlanFinde from '../assets/carrusel/02-camper-120-up-recorriendo-un-pueblo-andaluz.jpg';
import imgPlanEventos from '../assets/img/futbol-eventos-estadio.jpg';
import imgPlanVacaciones from '../assets/img/ruta-autocaravana-montana.webp';

const today = new Date().toISOString().slice(0, 10);
const activeOffers = offers.filter((o) => o.until >= today);
const untilLabel = (d: string) => (d && d < '2999' ? `Válida hasta el ${new Date(d + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })}` : '');
const camperBaja = getVehicle('camper').prices.baja.short;
const offerVehicleId = (label?: string) => (/mileo/i.test(label || '') ? 'mileo' : 'camper') as 'camper' | 'mileo';
const offerPhotos = {
  camper: await getImage({ src: getVehicle('camper').hero, width: 900, height: 506, format: 'webp' }),
  mileo: await getImage({ src: getVehicle('mileo').hero, width: 900, height: 506, format: 'webp' }),
};

const ventajas = [
  { icon: 'shield', t: 'Seguro y asistencia 24 h' },
  { icon: 'paw', t: 'Mascotas gratis' },
  { icon: 'parking', t: 'Parking gratis para tu coche' },
  { icon: 'phone', t: site.phoneDisplay, href: `tel:${site.phone}` },
];

const planes = [
  { img: imgPlanFinde, t: 'Fin de semana', d: `De viernes a domingo desde ${camperBaja} €/día (${camperBaja * 3} € los 3 días).`, href: '/alquiler-autocaravana-fin-de-semana-sevilla/' },
  { img: imgAracena, t: 'Puentes y festivos', d: 'Constitución, Andalucía, Semana Santa, mayo… Reserva con tiempo.', href: '/alquiler-autocaravana-puente-sevilla/' },
  { img: imgPlanEventos, t: 'Fútbol y eventos', d: 'Sevilla, Betis, el Bernabéu, conciertos… Consúltanos aunque sean menos de 3 días.', href: '/alquiler-autocaravana-eventos-futbol-sevilla/' },
  { img: imgPlanVacaciones, t: 'Vacaciones largas', d: 'Más de 7 días con km ilimitados y tarifa reducida desde 15 días.', href: '/tarifas/' },
  { img: imgCadiz, t: 'Ofertas temporada baja', d: 'De octubre a marzo, la forma más barata de viajar en autocaravana.', href: '/ofertas-alquiler-autocaravana-sevilla/' },
];

const destinoImg: Record<string, { img: ImageMetadata; name: string; d: string }> = {
  'costa-de-cadiz-en-autocaravana': { img: imgCadiz, name: 'Costa de Cádiz', d: 'Playas salvajes, pueblos blancos y buena mesa a hora y media.' },
  'huelva-donana-sierra-de-aracena': { img: imgAracena, name: 'Doñana y Sierra de Aracena', d: 'Naturaleza, senderos, jamón y castañares.' },
  'algarve-portugal-en-autocaravana': { img: imgAlgarve, name: 'Algarve', d: 'Cruza la frontera: calas, acantilados y áreas para autocaravanas.' },
};
const destinos = rutas.filter((r) => destinoImg[r.slug]).map((r) => ({ ...destinoImg[r.slug], href: `/rutas/${r.slug}/` }));
---
<Base
  title="Alquiler de Autocaravanas en Sevilla desde {all.desde} €/día | RG MEGA"
  description="Alquiler de autocaravanas y campers en Sevilla: Benimar Mileo 268 y Camper 120 UP nuevas. Recogida en Salteras, seguro y asistencia 24 h incluidos, mascotas gratis. Fin de semana, puentes y vacaciones."
>
  <!-- HERO: las dos autocaravanas, cada una con su nombre y su precio -->
  <section class="hero">
    <div class="container hero__in">
      <div class="hero__copy">
        <p class="hero__claim">Tu próxima escapada empieza aquí</p>
        <h1>Alquiler de autocaravanas en Sevilla</h1>
        <p class="hero__lead">Dos Benimar nuevas para elegir: la <strong>Mileo 268</strong>, perfilada para 4 con garaje, y la <strong>Camper 120 UP</strong>, compacta y fácil de conducir. Recogida en Sevilla y trato directo, sin intermediarios.</p>
        <div class="hero__btns">
          <a class="btn btn--light btn--lg" href="/calendario-disponibilidad/"><Icon name="calendar" /> Consultar disponibilidad</a>
          <a class="hero__link" href="/tarifas/">Ver precios <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="hero__fleet">
        {vehicles.map((v, i) => (
          <a class="hv" href={v.slug}>
            <Image src={v.hero} alt={`${v.name} de alquiler en Sevilla`} widths={[480, 800, 1100]} sizes="(max-width: 560px) 50vw, (max-width: 900px) 100vw, 600px" loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} />
            <span class="hv__cap">
              <span class="hv__name"><strong>{v.short}</strong><small>{v.type}</small></span>
              <span class="hv__price">desde <b><span data-from={v.id}>{fromPrice(v)}</span> €</b>/día</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BUSCADOR + VENTAJAS -->
  <section class="finder" id="buscar-disponibilidad" aria-labelledby="buscar-t">
    <div class="container">
      <div class="finder__card">
        <h2 id="buscar-t" class="finder__t">¿Cuándo quieres salir?</h2>
        <form class="search" action="/calendario-disponibilidad/#presupuesto" method="get" aria-label="Buscar disponibilidad">
          <label class="search__f">
            <span>Vehículo</span>
            <select name="modelo">
              <option value="">Cualquier vehículo</option>
              {vehicles.map((v) => <option value={v.id}>{v.name}</option>)}
            </select>
          </label>
          <label class="search__f">
            <span>Recogida</span>
            <input type="date" name="salida" />
          </label>
          <label class="search__f">
            <span>Devolución</span>
            <input type="date" name="llegada" />
          </label>
          <button class="btn btn--primary search__go" type="submit">Ver disponibilidad <Icon name="arrow" class="i-arrow" /></button>
        </form>
      </div>
      <ul class="perks">
        {ventajas.map((v) => (
          <li>
            <Icon name={v.icon} />
            {'href' in v && v.href ? <a href={v.href}>{v.t}</a> : <span>{v.t}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- OFERTAS -->
  <section class="section section--sand offers-sec" aria-labelledby="ofertas-t" data-offers-wrap hidden={activeOffers.length === 0}>
    <div class="container">
      <div class="offers-head">
        <h2 id="ofertas-t">Ofertas del momento</h2>
        <a class="more-link" href="/ofertas-alquiler-autocaravana-sevilla/">Ver todas las ofertas <Icon name="arrow" /></a>
      </div>
      <div class="offers" data-offers>
        <template>
          <a class="offer" href="/ofertas-alquiler-autocaravana-sevilla/" data-vehicle="camper">
            <span class="offer__media" aria-hidden="true">
              <img class="offer__photo" data-for="camper" src={offerPhotos.camper.src} width={offerPhotos.camper.attributes.width} height={offerPhotos.camper.attributes.height} alt="" loading="lazy" decoding="async" />
              <img class="offer__photo" data-for="mileo" src={offerPhotos.mileo.src} width={offerPhotos.mileo.attributes.width} height={offerPhotos.mileo.attributes.height} alt="" loading="lazy" decoding="async" />
            </span>
            <span class="offer__body">
              <span class="offer__model" data-f="vehicle"></span>
              <strong class="offer__title" data-f="title"></strong>
              <span class="offer__text" data-f="text"></span>
              <span class="offer__until" data-f="until"></span>
              <span class="offer__foot">
                <span class="offer__stamp">desde <b><span data-f="amount"></span> €</b>/día</span>
                <span class="offer__cta">Reservar <Icon name="arrow" /></span>
              </span>
            </span>
          </a>
        </template>
        {activeOffers.map((o) => (
          <a class="offer" href="/ofertas-alquiler-autocaravana-sevilla/" data-vehicle={offerVehicleId(o.vehicle)}>
            <span class="offer__media" aria-hidden="true">
              <img class="offer__photo" data-for="camper" src={offerPhotos.camper.src} width={offerPhotos.camper.attributes.width} height={offerPhotos.camper.attributes.height} alt="" loading="lazy" decoding="async" />
              <img class="offer__photo" data-for="mileo" src={offerPhotos.mileo.src} width={offerPhotos.mileo.attributes.width} height={offerPhotos.mileo.attributes.height} alt="" loading="lazy" decoding="async" />
            </span>
            <span class="offer__body">
              <span class="offer__model" hidden={!o.vehicle}>{o.vehicle}</span>
              <strong class="offer__title">{o.title}</strong>
              <span class="offer__text">{o.text}</span>
              <span class="offer__until" hidden={!untilLabel(o.until)}>{untilLabel(o.until)}</span>
              <span class="offer__foot">
                <span class="offer__stamp" hidden={!o.price}>desde <b><span>{o.price}</span> €</b>/día</span>
                <span class="offer__cta">Reservar <Icon name="arrow" /></span>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER -->
  <section class="ritmo" aria-labelledby="ritmo-t">
    <div class="ritmo__copy">
      <span class="eyebrow">Libertad total</span>
      <h2 id="ritmo-t">Viaja a tu ritmo</h2>
      <p>Para donde quieras, duerme frente al mar o en la sierra y vuelve cuando te apetezca. Tu casa va contigo.</p>
      <a class="btn btn--light" href="/calendario-disponibilidad/">Consultar disponibilidad <Icon name="arrow" class="i-arrow" /></a>
    </div>
    <Image src={imgBanner} alt="Autocaravana Benimar en una carretera de montaña al atardecer" class="ritmo__img" widths={[700, 1100, 1536]} sizes="(max-width: 860px) 100vw, 50vw" />
  </section>

  <!-- PARA CADA PLAN -->
  <section class="section plans-sec">
    <div class="container plans-sec__in">
      <div class="section-head plans-sec__head">
        <h2>Fin de semana, puente o vacaciones: tú decides</h2>
        <p class="lead">Alquiler mínimo de 3 días (para eventos especiales, consúltanos). Sevilla está a menos de 2 horas de la costa, la sierra y Portugal.</p>
      </div>
      <div class="plans">
        {planes.map((p) => (
          <a class="plan" href={p.href}>
            <span class="plan__ic">
              <Image src={p.img} alt="" widths={[320, 560, 800]} sizes="(max-width: 520px) 88px, (max-width: 1080px) 45vw, 280px" />
            </span>
            <strong>{p.t}</strong>
            <span class="plan__d">{p.d}</span>
            <span class="plan__go">Ver más <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- OPINIONES -->
  <section class="section section--sand">
    <div class="container reviews">
      <div class="reviews__head">
        <h2>Opiniones de nuestros viajeros</h2>
        <p class="lead">La satisfacción de quienes ya han viajado con RG MEGA es lo que más nos motiva.</p>
      </div>
      <Reviews />
    </div>
  </section>

  <!-- ESCAPADAS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Escapadas que apetece vivir</h2>
        <p class="lead">Ideas de rutas desde Sevilla para disfrutar en autocaravana.</p>
      </div>
      <div class="dest">
        {destinos.map((d) => (
          <a class="dest__card" href={d.href}>
            <Image src={d.img} alt={`Autocaravana en ruta: ${d.name}`} widths={[420, 700]} sizes="(max-width: 760px) 100vw, 380px" />
            <span class="dest__txt"><strong>{d.name}</strong><span>{d.d}</span></span>
          </a>
        ))}
      </div>
      <p class="more"><a href="/rutas/">Ver todas las rutas <Icon name="arrow" /></a></p>
    </div>
  </section>

  <Location />

  <!-- DUDAS -->
  <section class="section">
    <div class="narrow">
      <div class="kf-wrap"><KeyFacts /></div>
      <div class="section-head">
        <h2>Dudas frecuentes</h2>
        <p class="lead">Lo que más nos preguntáis antes de reservar.</p>
      </div>
      <FaqList items={faqsBy('home', 6)} />
      <p class="more"><a href="/preguntas-frecuentes/">Ver todas las preguntas frecuentes <Icon name="arrow" /></a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Buscador: fechas mínimas
  const f = document.querySelector<HTMLFormElement>('form.search');
  if (f) {
    const a = f.querySelector<HTMLInputElement>('[name=salida]')!, b = f.querySelector<HTMLInputElement>('[name=llegada]')!;
    const t = new Date(); t.setMinutes(t.getMinutes() - t.getTimezoneOffset());
    a.min = b.min = t.toISOString().slice(0, 10);
    a.addEventListener('change', () => { b.min = a.value || a.min; if (b.value && b.value < a.value) b.value = ''; });
    // No enviar parámetros vacíos
    f.addEventListener('submit', () => f.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => { el.disabled = !el.value; }));
    addEventListener('pageshow', () => f.querySelectorAll<HTMLInputElement>('[name]').forEach((el) => { el.disabled = false; }));
  }
</script>

<style>
  /* HERO */
  .hero { background: var(--forest); color: #fff; }
  .hero__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 4vw, 3.5rem); align-items: center; padding: clamp(40px, 5vw, 64px) 0 clamp(112px, 11vw, 140px); }
  .hero__claim { font-family: var(--display); font-weight: 700; font-size: clamp(2.5rem, 5.2vw, 4.2rem); line-height: 1; letter-spacing: -.025em; margin: 0 0 .9rem; max-width: 12ch; text-wrap: balance; }
  .hero h1 { color: rgba(255,255,255,.8); font-family: var(--font); font-size: .85rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 .9rem; display: flex; align-items: center; gap: .65em; }
  .hero h1::before { content: ''; width: 1.8em; height: 2px; border-radius: 2px; background: var(--terra); }
  .hero__lead { font-size: 1.08rem; color: var(--on-dark); max-width: 46ch; margin: 0 0 1.4rem; }
  .hero__lead strong { color: #fff; }
  .hero__btns { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  .hero__link { display: inline-flex; align-items: center; gap: .4rem; color: #fff; font-weight: 600; text-decoration: none; border-bottom: 2px solid rgba(255,255,255,.4); padding-bottom: .15rem; }
  .hero__link:hover { color: #fff; border-bottom-color: #fff; }
  .hero__link :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .hero__link:hover :global(svg) { transform: translateX(3px); }
  .hero__fleet { display: grid; gap: 12px; }
  .hv { position: relative; display: block; aspect-ratio: 16 / 8; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; isolation: isolate; }
  .hv :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .hv:hover :global(img) { transform: scale(1.04); }
  .hv::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(14,24,19,.82) 0%, rgba(14,24,19,.15) 50%, transparent 70%); }
  .hv:hover { color: #fff; }
  .hv__cap { position: absolute; left: 1.1rem; right: 1.1rem; bottom: .9rem; display: flex; align-items: flex-end; justify-content: space-between; gap: .5rem 1rem; flex-wrap: wrap; }
  .hv__name { display: grid; line-height: 1.15; }
  .hv__name strong { font-family: var(--display); font-size: 1.45rem; }
  .hv__name small { font-size: .82rem; color: var(--on-dark); }
  .hv__price { font-size: .9rem; color: var(--on-dark); white-space: nowrap; }
  .hv__price b { font-family: var(--display); font-size: 1.6rem; color: #fff; margin-left: .2rem; letter-spacing: -.02em; }

  /* BUSCADOR + VENTAJAS */
  .finder { position: relative; z-index: 2; padding-bottom: clamp(56px, 7vw, 88px); }
  .finder__card { margin-top: -72px; background: #fff; border-radius: var(--radius); box-shadow: 0 0 0 1px var(--line), 0 24px 60px -24px rgba(14,24,19,.35); padding: 1.4rem 1.5rem 1.5rem; }
  .finder__t { font-size: 1.25rem; margin: 0 0 .9rem; }
  .search { display: grid; grid-template-columns: 1.2fr 1fr 1fr auto; gap: 1rem; align-items: end; }
  .search__f { display: grid; gap: .35rem; font-size: .85rem; font-weight: 650; color: var(--ink); }
  .search__f select, .search__f input { width: 100%; height: 50px; padding: 0 .9em; border: 1.5px solid var(--line); border-radius: var(--radius-sm); font: inherit; font-weight: 500; font-size: .95rem; background: #fff; color: var(--ink); }
  .search__f select:focus, .search__f input:focus { outline: none; border-color: var(--forest); box-shadow: 0 0 0 4px rgba(31,74,56,.12); }
  .search__go { height: 50px; }
  .perks { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .perks li { display: flex; align-items: center; gap: .7rem; font-weight: 600; font-size: .98rem; color: var(--ink); }
  .perks a { color: var(--ink); text-decoration: none; }
  .perks a:hover { color: var(--forest); }
  .perks :global(svg) { width: 24px; height: 24px; color: var(--forest); flex: none; stroke-width: 1.8; }

  /* OFERTAS */
  .offers-sec[hidden] { display: none; }
  .offers-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; margin-bottom: 1.8rem; }
  .offers-head h2 { margin: 0; }
  .more-link { display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; color: var(--forest); text-decoration: none; }
  .more-link :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .more-link:hover :global(svg) { transform: translateX(3px); }
  .offers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .offer { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); background: #fff; border-radius: var(--radius); overflow: hidden; color: var(--ink); text-decoration: none; box-shadow: var(--shadow); transition: box-shadow .3s, transform .3s cubic-bezier(.2,.8,.2,1); }
  .offer:hover { color: var(--ink); transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .offer__media { position: relative; overflow: hidden; background: var(--sand-2); min-height: 220px; }
  .offer__photo { display: none; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.8,.2,1); }
  .offer:not([data-vehicle="mileo"]) .offer__photo[data-for="camper"],
  .offer[data-vehicle="mileo"] .offer__photo[data-for="mileo"] { display: block; position: absolute; inset: 0; }
  .offer:hover .offer__photo { transform: scale(1.04); }
  .offer__body { display: flex; flex-direction: column; gap: .45rem; padding: 1.4rem 1.5rem; }
  .offer__model { font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .offer__title { font-family: var(--display); font-weight: 700; font-size: clamp(1.2rem, 2vw, 1.4rem); line-height: 1.15; }
  .offer__text { font-size: .93rem; color: var(--muted); }
  .offer__until { font-size: .82rem; font-weight: 600; color: var(--ink); display: inline-flex; align-items: center; gap: .4rem; }
  .offer__until::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--terra); }
  .offer__foot { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1rem; margin-top: auto; padding-top: .9rem; border-top: 1px solid var(--line); }
  .offer__stamp { font-size: .9rem; color: var(--muted); }
  .offer__stamp b { font-family: var(--display); font-size: 1.9rem; color: var(--price); letter-spacing: -.02em; margin-inline: .1rem; }
  .offer__cta { display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; font-size: .95rem; color: var(--forest); }
  .offer__cta :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .offer:hover .offer__cta :global(svg) { transform: translateX(4px); }
  .offer [hidden], .offer__stamp:has([data-f=amount][hidden]) { display: none; }
  @media (max-width: 1000px) { .offers { grid-template-columns: minmax(0, 1fr); } }

  /* BANNER */
  .ritmo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); background: var(--forest); color: #fff; min-height: 440px; overflow: hidden; }
  .ritmo__copy { align-self: center; padding: 3rem 2.5rem 3rem max(16px, calc((100vw - var(--max)) / 2)); }
  .ritmo h2 { color: #fff; font-size: clamp(2rem, 3.8vw, 2.8rem); margin-bottom: .35em; }
  .ritmo p { color: var(--on-dark); font-size: 1.1rem; max-width: 40ch; margin-bottom: 1.6rem; }
  .ritmo__img { width: 100%; height: 100%; min-height: 440px; max-height: 540px; object-fit: cover; object-position: center 60%; }

  /* PLANES: composición abierta, sin cajas */
  .plans-sec__head { max-width: 52rem; }
  .plans { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2rem 1.5rem; }
  .plan { display: flex; flex-direction: column; gap: .5rem; text-decoration: none; color: var(--ink); }
  .plan:hover { color: var(--ink); }
  .plan__ic { display: block; aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; background: var(--sand); margin-bottom: .5rem; }
  .plan__ic :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s cubic-bezier(.2,.8,.2,1); }
  .plan:hover .plan__ic :global(img) { transform: scale(1.05); }
  .plan strong { font-family: var(--display); font-size: 1.25rem; }
  .plan__d { font-size: .95rem; line-height: 1.5; color: var(--muted); flex: 1; }
