---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import VehicleCard from '../components/VehicleCard.astro';
import Reviews from '../components/Reviews.astro';
import FaqList from '../components/FaqList.astro';
import Instagram from '../components/Instagram.astro';
import Location from '../components/Location.astro';
import CtaBand from '../components/CtaBand.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import PriceNote from '../components/PriceNote.astro';
import { offers, heroPrice } from '../data/site';
import { offerPriceLabel } from '../data/sheet';
import { vehicles, getVehicle, fromPrice } from '../data/vehicles';
import { rutas } from '../data/rutas';
import { faqsBy } from '../data/faqs';
import hero from '../assets/img/benimar-mileo-268-alquiler-sevilla.jpg';
import imgBanner from '../assets/img/viaja-a-tu-ritmo.webp';
import imgCadiz from '../assets/img/ruta-camper-costa.webp';
import imgAracena from '../assets/img/escapada-sierra-aracena.webp';
import imgAlgarve from '../assets/img/escapada-algarve.webp';

const today = new Date().toISOString().slice(0, 10);
const activeOffers = offers.filter((o) => o.until >= today);
const camperBaja = getVehicle('camper').prices.baja.short;
const heroV = getVehicle(heroPrice.vehicle);
const heroText = heroPrice.text || `${heroV.short} desde`;
const heroAmount = heroPrice.price ?? fromPrice(heroV);

const ventajas = [
  { icon: 'shield', t: 'Seguro y asistencia 24 h' },
  { icon: 'paw', t: 'Mascotas gratis' },
  { icon: 'parking', t: 'Parking gratis para tu coche' },
  { icon: 'headset', t: 'Atención directa' },
];

const planes = [
  { icon: 'sun', t: 'Fin de semana', d: `De viernes a domingo desde ${camperBaja} €/día (${camperBaja * 3} € los 3 días).`, href: '/alquiler-autocaravana-fin-de-semana-sevilla/' },
  { icon: 'calendar', t: 'Puentes y festivos', d: 'Constitución, Andalucía, Semana Santa, mayo… Reserva con tiempo.', href: '/alquiler-autocaravana-puente-sevilla/' },
  { icon: 'star', t: 'Fútbol y eventos', d: 'Sevilla, Betis, el Bernabéu, conciertos… Consúltanos aunque sean menos de 3 días.', href: '/alquiler-autocaravana-eventos-futbol-sevilla/' },
  { icon: 'route', t: 'Vacaciones largas', d: 'Más de 7 días con km ilimitados y tarifa reducida desde 15 días.', href: '/tarifas/' },
  { icon: 'euro', t: 'Ofertas temporada baja', d: 'De octubre a marzo, la forma más barata de viajar en autocaravana.', href: '/ofertas-alquiler-autocaravana-sevilla/' },
];

const destinoImg: Record<string, { img: ImageMetadata; name: string; d: string }> = {
  'costa-de-cadiz-en-autocaravana': { img: imgCadiz, name: 'Costa de Cádiz', d: 'Playas salvajes, pueblos blancos y buena mesa a hora y media.' },
  'huelva-donana-sierra-de-aracena': { img: imgAracena, name: 'Doñana y Sierra de Aracena', d: 'Naturaleza, senderos, jamón y castañares.' },
  'algarve-portugal-en-autocaravana': { img: imgAlgarve, name: 'Algarve', d: 'Cruza la frontera: calas, acantilados y áreas para autocaravanas.' },
};
const destinos = rutas.filter((r) => destinoImg[r.slug]).map((r) => ({ ...destinoImg[r.slug], href: `/rutas/${r.slug}/` }));
---
<Base
  title="Alquiler de Autocaravanas en Sevilla desde {all.desde} €/día | RG MEGA"
  description="Alquiler de autocaravanas y campers en Sevilla: Benimar Mileo 268 y Camper 120 UP nuevas. Recogida en Salteras, seguro y asistencia 24 h incluidos, mascotas gratis. Fin de semana, puentes y vacaciones."
>
  <!-- HERO -->
  <section class="hero">
    <Image src={hero} alt="Autocaravana Benimar Mileo 268 de alquiler en Sevilla" class="hero__bg" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="container hero__in">
      <p class="hero__claim">Tu próxima escapada empieza aquí</p>
      <h1>Alquiler de autocaravanas en Sevilla</h1>
      <p class="hero__lead">Dos Benimar nuevas, con recogida y entrega en Sevilla. Sin intermediarios: te atendemos nosotros, de principio a fin.</p>
      <div class="btn-row hero__btns">
        <a class="btn btn--primary" href="#autocaravanas">Ver autocaravanas <Icon name="arrow" class="i-arrow" /></a>
        <a class="btn btn--outline-light" href="/calendario-disponibilidad/">Consultar disponibilidad</a>
      </div>
      <div class="hero__price">
        <p><span data-hero-text>{heroText}</span> <strong class="price-badge"><span data-hero-price data-auto={heroPrice.price == null ? heroPrice.vehicle : undefined}>{heroAmount}</span> €/día</strong></p>
        <PriceNote tone="dark" compact />
      </div>
    </div>
  </section>

  <!-- BUSCADOR -->
  <div class="container search-wrap">
    <form class="search" action="/calendario-disponibilidad/#presupuesto" method="get" aria-label="Buscar disponibilidad">
      <label class="search__f">
        <span>Vehículo</span>
        <select name="modelo">
          <option value="">Cualquier vehículo</option>
          {vehicles.map((v) => <option value={v.id}>{v.name}</option>)}
        </select>
      </label>
      <label class="search__f">
        <span>Recogida</span>
        <input type="date" name="salida" />
      </label>
      <label class="search__f">
        <span>Devolución</span>
        <input type="date" name="llegada" />
      </label>
      <button class="btn btn--primary search__go" type="submit"><Icon name="calendar" /> Buscar disponibilidad</button>
    </form>
    <ul class="perks">
      {ventajas.map((v) => <li><Icon name={v.icon} /><span>{v.t}</span></li>)}
    </ul>
  </div>

  <!-- OFERTAS -->
  <section class="container offers" aria-label="Ofertas" data-offers hidden={activeOffers.length === 0}>
    <template><a class="offer" href="/ofertas-alquiler-autocaravana-sevilla/"><span class="offer__tag">Oferta</span><strong data-f="title"></strong><span class="offer__text" data-f="text"></span><em class="offer__price" data-f="price"></em><Icon name="arrow" /></a></template>
    {activeOffers.map((o) => (
      <a class="offer" href="/ofertas-alquiler-autocaravana-sevilla/"><span class="offer__tag">Oferta</span><strong>{o.title}</strong><span class="offer__text">{o.text}</span><em class="offer__price" hidden={!o.price}>{offerPriceLabel(o)}</em><Icon name="arrow" /></a>
    ))}
  </section>

  <!-- FLOTA -->
  <section class="section section--sand" id="autocaravanas">
    <div class="container">
      <div class="section-head">
        <h2>Elige cómo quieres viajar</h2>
        <p class="lead">Solo dos vehículos, siempre impecables: los conocemos al detalle y te los entregamos en persona.</p>
      </div>
      <div class="grid grid-2">
        {vehicles.map((v) => <VehicleCard vehicle={v} />)}
      </div>
    </div>
  </section>

  <!-- BANNER -->
  <section class="ritmo" aria-labelledby="ritmo-t">
    <div class="ritmo__copy">
      <h2 id="ritmo-t">Viaja a tu ritmo</h2>
      <p>Para donde quieras, duerme frente al mar o en la sierra y vuelve cuando te apetezca. Tu casa va contigo.</p>
      <a class="btn btn--light" href="/calendario-disponibilidad/">Consultar disponibilidad <Icon name="arrow" class="i-arrow" /></a>
    </div>
    <Image src={imgBanner} alt="Autocaravana Benimar en una carretera de montaña al atardecer" class="ritmo__img" widths={[700, 1100, 1536]} sizes="(max-width: 860px) 100vw, 60vw" />
  </section>

  <!-- GALERÍA -->
  <PhotoCarousel />

  <!-- PARA CADA PLAN -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <h2>Fin de semana, puente o vacaciones: tú decides</h2>
        <p class="lead">Alquiler mínimo de 3 días (para eventos especiales, consúltanos). Sevilla está a menos de 2 horas de la costa, la sierra y Portugal.</p>
      </div>
      <div class="plans">
        {planes.map((p) => (
          <a class="plan" href={p.href}>
            <span class="plan__ic"><Icon name={p.icon} /></span>
            <strong>{p.t}</strong>
            <span class="plan__d">{p.d}</span>
            <span class="plan__go">Ver más <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ESCAPADAS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Escapadas que apetece vivir</h2>
        <p class="lead">Ideas de rutas desde Sevilla para disfrutar en autocaravana.</p>
      </div>
      <div class="dest">
        {destinos.map((d) => (
          <a class="dest__card" href={d.href}>
            <Image src={d.img} alt={`Autocaravana en ruta: ${d.name}`} widths={[420, 700]} sizes="(max-width: 760px) 100vw, 380px" />
            <span class="dest__txt"><strong>{d.name}</strong><span>{d.d}</span></span>
          </a>
        ))}
      </div>
      <p class="more"><a href="/rutas/">Ver todas las rutas <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- OPINIONES -->
  <section class="section section--sand">
    <div class="container reviews">
      <div class="reviews__head">
        <h2>Opiniones de nuestros viajeros</h2>
        <p class="lead">La satisfacción de quienes ya han viajado con RG MEGA es lo que más nos motiva.</p>
      </div>
      <Reviews />
    </div>
  </section>

  <Instagram />

  <!-- DUDAS -->
  <section class="section section--sand">
    <div class="narrow">
      <div class="section-head">
        <h2>Dudas frecuentes</h2>
        <p class="lead">Lo que más nos preguntáis antes de reservar.</p>
      </div>
      <FaqList items={faqsBy('home', 8)} />
      <p class="more"><a href="/preguntas-frecuentes/">Ver todas las preguntas frecuentes <Icon name="arrow" /></a></p>
    </div>
  </section>

  <Location />
  <CtaBand />
</Base>

<script>
  // Buscador: fechas mínimas
  const f = document.querySelector<HTMLFormElement>('form.search');
  if (f) {
    const a = f.querySelector<HTMLInputElement>('[name=salida]')!, b = f.querySelector<HTMLInputElement>('[name=llegada]')!;
    const t = new Date(); t.setMinutes(t.getMinutes() - t.getTimezoneOffset());
    a.min = b.min = t.toISOString().slice(0, 10);
    a.addEventListener('change', () => { b.min = a.value || a.min; if (b.value && b.value < a.value) b.value = ''; });
    // No enviar parámetros vacíos
    f.addEventListener('submit', () => f.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => { el.disabled = !el.value; }));
    addEventListener('pageshow', () => f.querySelectorAll<HTMLInputElement>('[name]').forEach((el) => { el.disabled = false; }));
  }
</script>

<style>
  /* HERO */
  .hero { position: relative; color: #fff; overflow: hidden; isolation: isolate; min-height: clamp(520px, 78vh, 720px); display: flex; align-items: center; }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(90deg, rgba(20,32,26,.82) 0%, rgba(20,32,26,.55) 42%, rgba(20,32,26,.08) 75%),
    linear-gradient(0deg, rgba(20,32,26,.55) 0%, transparent 35%),
    linear-gradient(180deg, rgba(246,174,45,.18), transparent 40%); }
  .hero__in { padding: clamp(56px, 8vw, 96px) 0 clamp(96px, 12vw, 140px); }
  .hero__claim { font-family: var(--display); font-weight: 700; font-size: clamp(2.5rem, 6.2vw, 4.6rem); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 .6rem; max-width: 12ch; text-wrap: balance; }
  .hero h1 { color: #fff; font-size: clamp(1.2rem, 2.2vw, 1.6rem); font-weight: 600; margin: 0 0 .9rem; letter-spacing: 0; }
  .hero__lead { font-size: 1.08rem; color: #e6efe9; max-width: 46ch; margin: 0 0 1.6rem; }
  .hero__btns { margin-bottom: 1.5rem; }
  .hero__price p { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .55rem; margin: 0; font-weight: 600; font-size: 1.05rem; }
  .hero__price .price-badge { font-family: var(--display); font-size: 1.3em; font-weight: 700; }
  .hero__price :global(.pn) { margin-top: .35rem; max-width: 46ch; }

  /* BUSCADOR */
  .search-wrap { position: relative; z-index: 2; margin-top: -64px; }
  .search { display: grid; grid-template-columns: 1.2fr 1fr 1fr auto; gap: 1rem; align-items: end; background: #fff; border-radius: var(--radius); padding: 1.2rem 1.4rem; box-shadow: var(--shadow-lg); }
  .search__f { display: grid; gap: .35rem; font-size: .85rem; font-weight: 650; color: var(--ink); }
  .search__f select, .search__f input { width: 100%; padding: .75em .9em; border: 1.5px solid var(--line); border-radius: 10px; font: inherit; font-weight: 500; font-size: .95rem; background: #fff; color: var(--ink); }
  .search__f select:focus, .search__f input:focus { outline: none; border-color: var(--forest); box-shadow: 0 0 0 4px rgba(31,74,56,.12); }
  .search__go { height: 48px; }
  .perks { list-style: none; margin: 0; padding: 1.4rem 0 .4rem; display: grid; grid-template-columns: repeat(4, 1fr); }
  .perks li { display: flex; align-items: center; justify-content: center; gap: .65rem; padding: .3rem 1rem; font-weight: 600; font-size: .95rem; color: var(--ink); }
  .perks li + li { border-left: 1px solid var(--line); }
  .perks :global(svg) { width: 26px; height: 26px; color: var(--forest); flex: none; stroke-width: 1.7; }

  /* OFERTAS */
  .offers { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 1rem; margin-block: 1.6rem 2.6rem; }
  .offers[hidden] { display: none; }
  .offer { display: grid; grid-template-columns: auto 1fr auto; grid-template-rows: auto auto auto; column-gap: 1rem; align-items: center; padding: 1.1rem 1.3rem; border-radius: var(--radius); background: #fff; box-shadow: 0 0 0 1px rgba(31,74,56,.1), 0 10px 24px -18px rgba(31,74,56,.5); text-decoration: none; color: var(--ink); transition: box-shadow .25s, transform .25s cubic-bezier(.2,.8,.2,1); }
  .offer:hover { color: var(--ink); transform: translateY(-2px); box-shadow: var(--shadow); }
  .offer__tag { grid-row: 1 / span 3; align-self: center; background: var(--red); color: #fff; font-weight: 700; font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; padding: .35rem .6rem; border-radius: 8px; }
  .offer strong { color: var(--forest); font-family: var(--display); font-weight: 700; font-size: 1.1rem; }
  .offer .offer__text { font-size: .9rem; color: var(--muted); grid-column: 2; }
  .offer__price { grid-column: 2; justify-self: start; margin-top: .45rem; font-style: normal; font-weight: 700; font-size: .88rem; color: var(--price); }
  .offer__price[hidden] { display: none; }
  .offer :global(svg) { grid-row: 1 / span 3; grid-column: 3; width: 20px; color: var(--forest); }

  /* BANNER DIAGONAL */
  .ritmo { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); background: var(--forest); color: #fff; min-height: 340px; overflow: hidden; }
  .ritmo__copy { position: relative; z-index: 1; align-self: center; padding: 3rem max(16px, calc((100vw - var(--max)) / 2)) 3rem; padding-right: 2rem; }
  .ritmo h2 { color: #fff; font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: .4em; }
  .ritmo p { color: #d4e3da; max-width: 40ch; margin-bottom: 1.5rem; }
  .ritmo__img { width: 100%; height: 100%; object-fit: cover; clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%); margin-left: -12%; width: 112%; }

  /* PLANES */
  .plans { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; }
  .plan { display: flex; flex-direction: column; gap: .4rem; padding: 1.3rem 1.2rem 1.1rem; background: #fff; border-radius: var(--radius); box-shadow: 0 0 0 1px rgba(31,74,56,.08); text-decoration: none; color: var(--ink); transition: box-shadow .25s, transform .25s cubic-bezier(.2,.8,.2,1); }
  .plan:hover { color: var(--ink); transform: translateY(-3px); box-shadow: var(--shadow); }
  .plan__ic { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--forest); color: var(--sub); margin-bottom: .4rem; }
  .plan:nth-child(even) .plan__ic { background: var(--terra); color: #fff; }
  .plan__ic :global(svg) { width: 23px; height: 23px; }
  .plan strong { font-family: var(--display); font-size: 1.12rem; color: var(--forest); }
  .plan__d { font-size: .88rem; color: var(--muted); flex: 1; }
  .plan__go { display: inline-flex; align-items: center; gap: .3rem; margin-top: .4rem; font-size: .85rem; font-weight: 700; color: var(--price); }
  .plan__go :global(svg) { width: 15px; height: 15px; transition: transform .2s; }
  .plan:hover .plan__go :global(svg) { transform: translateX(3px); }

  /* DESTINOS */
  .dest { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .dest__card { position: relative; display: block; aspect-ratio: 4/3; border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none; box-shadow: var(--shadow); isolation: isolate; }
  .dest__card :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -1; transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .dest__card:hover :global(img) { transform: scale(1.05); }
  .dest__card::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(15,26,20,.85) 0%, rgba(15,26,20,.25) 45%, transparent 70%); }
  .dest__txt { position: absolute; left: 1.2rem; right: 1.2rem; bottom: 1.1rem; display: grid; gap: .2rem; }
  .dest__txt strong { font-family: var(--display); font-size: 1.4rem; }
  .dest__txt span { font-size: .9rem; color: #e6efe9; }
  .dest__card:hover { color: #fff; }

  /* OPINIONES */
  .reviews { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 2.2fr); gap: 2.5rem; align-items: start; }
  .reviews__head h2 { margin-bottom: .4em; }
  @media (min-width: 700px) { .reviews :global(.rv__grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .reviews__score { display: flex; align-items: center; gap: .5rem; margin-top: 1rem; font-weight: 700; color: var(--forest); }
  .reviews__stars { display: inline-flex; gap: 2px; color: var(--terra); }
  .reviews__stars :global(svg) { width: 18px; height: 18px; }

  .more { margin: 1.4rem 0 0; }
  .more a { display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; color: var(--forest); text-decoration: none; }
  .more a:hover { text-decoration: underline; }
  .more :global(svg) { width: 16px; height: 16px; }

  @media (max-width: 1080px) {
    .plans { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .reviews { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  }
  @media (max-width: 860px) {
    .search { grid-template-columns: 1fr 1fr; }
    .search__f:first-child, .search__go { grid-column: 1 / -1; }
    .perks { grid-template-columns: 1fr 1fr; row-gap: .8rem; }
    .perks li { justify-content: flex-start; }
    .perks li + li { border-left: 0; }
    .ritmo { grid-template-columns: minmax(0, 1fr); }
    .ritmo__img { order: -1; clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%); margin-left: 0; width: 100%; aspect-ratio: 16/9; height: auto; }
    .ritmo__copy { padding: 1rem 16px 3rem; }
    .dest { grid-template-columns: minmax(0, 1fr); }
    .dest__card { aspect-ratio: 16/9; }
    .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .offer { grid-template-columns: minmax(0, 1fr) auto; row-gap: .3rem; }
    .offer__tag { grid-row: auto; grid-column: 1; justify-self: start; }
    .offer strong, .offer .offer__text, .offer__price { grid-column: 1; }
    .offer :global(svg) { grid-row: 1 / span 4; grid-column: 2; }
    .hero__claim { font-size: 2.4rem; }
    .search { grid-template-columns: minmax(0, 1fr); padding: 1rem; }
    .perks { grid-template-columns: minmax(0, 1fr); }
    .plans { grid-template-columns: minmax(0, 1fr); gap: .7rem; }
    .plan { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: .9rem; row-gap: .15rem; padding: 1rem; }
    .plan__ic { grid-row: 1 / span 3; margin: 0; width: 44px; height: 44px; }
    .plan__go { margin-top: .2rem; }
  }
</style>
