---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';
import FaqList from '../components/FaqList.astro';
import Location from '../components/Location.astro';
import CtaBand from '../components/CtaBand.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import { offers, site, waLink } from '../data/site';
import { vehicles, getVehicle } from '../data/vehicles';
import { rutas } from '../data/rutas';
import { faqsBy } from '../data/faqs';
import hero from '../assets/img/benimar-mileo-268-alquiler-sevilla.jpg';
import imgBanner from '../assets/img/viaja-a-tu-ritmo.webp';
import imgCadiz from '../assets/img/ruta-camper-costa.webp';
import imgAracena from '../assets/img/escapada-sierra-aracena.webp';
import imgAlgarve from '../assets/img/escapada-algarve.webp';
import imgPlanFinde from '../assets/carrusel/02-camper-120-up-recorriendo-un-pueblo-andaluz.jpg';
import imgPlanEventos from '../assets/img/futbol-eventos-estadio.jpg';
import imgPlanVacaciones from '../assets/img/ruta-autocaravana-montana.webp';

const today = new Date().toISOString().slice(0, 10);
const activeOffers = offers.filter((o) => o.until >= today);
const untilLabel = (d: string) => (d && d < '2999' ? `Válida hasta el ${new Date(d + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })}` : '');
const camperBaja = getVehicle('camper').prices.baja.short;
const offerVehicleId = (label?: string) => (/mileo/i.test(label || '') ? 'mileo' : 'camper') as 'camper' | 'mileo';
const offerPhotos = {
  camper: await getImage({ src: getVehicle('camper').hero, width: 900, height: 506, format: 'webp' }),
  mileo: await getImage({ src: getVehicle('mileo').hero, width: 900, height: 506, format: 'webp' }),
};
const marqueeItems = activeOffers.length
  ? activeOffers.map((o) => (o.price ? `${o.title} · desde ${o.price} €/día` : o.title))
  : ['Consulta nuestras ofertas especiales de alquiler'];

const ventajas = [
  { icon: 'shield', t: 'Seguro y asistencia 24 h' },
  { icon: 'paw', t: 'Mascotas gratis' },
  { icon: 'parking', t: 'Parking gratis para tu coche' },
  { icon: 'phone', t: site.phoneDisplay, href: `tel:${site.phone}` },
];

const planes = [
  { img: imgPlanFinde, t: 'Fin de semana', d: `De viernes a domingo desde ${camperBaja} €/día (${camperBaja * 3} € los 3 días).`, href: '/alquiler-autocaravana-fin-de-semana-sevilla/' },
  { img: imgAracena, t: 'Puentes y festivos', d: 'Constitución, Andalucía, Semana Santa, mayo… Reserva con tiempo.', href: '/alquiler-autocaravana-puente-sevilla/' },
  { img: imgPlanEventos, t: 'Fútbol y eventos', d: 'Sevilla, Betis, el Bernabéu, conciertos… Consúltanos aunque sean menos de 3 días.', href: '/alquiler-autocaravana-eventos-futbol-sevilla/' },
  { img: imgPlanVacaciones, t: 'Vacaciones largas', d: 'Más de 7 días con km ilimitados y tarifa reducida desde 15 días.', href: '/tarifas/' },
  { img: imgCadiz, t: 'Ofertas temporada baja', d: 'De octubre a marzo, la forma más barata de viajar en autocaravana.', href: '/ofertas-alquiler-autocaravana-sevilla/' },
];

const destinoImg: Record<string, { img: ImageMetadata; name: string; d: string }> = {
  'costa-de-cadiz-en-autocaravana': { img: imgCadiz, name: 'Costa de Cádiz', d: 'Playas salvajes, pueblos blancos y buena mesa a hora y media.' },
  'huelva-donana-sierra-de-aracena': { img: imgAracena, name: 'Doñana y Sierra de Aracena', d: 'Naturaleza, senderos, jamón y castañares.' },
  'algarve-portugal-en-autocaravana': { img: imgAlgarve, name: 'Algarve', d: 'Cruza la frontera: calas, acantilados y áreas para autocaravanas.' },
};
const destinos = rutas.filter((r) => destinoImg[r.slug]).map((r) => ({ ...destinoImg[r.slug], href: `/rutas/${r.slug}/` }));
---
<Base
  title="Alquiler de Autocaravanas en Sevilla desde {all.desde} €/día | RG MEGA"
  description="Alquiler de autocaravanas y campers en Sevilla: Benimar Mileo 268 y Camper 120 UP nuevas. Recogida en Salteras, seguro y asistencia 24 h incluidos, mascotas gratis. Fin de semana, puentes y vacaciones."
>
  <!-- HERO -->
  <section class="hero">
    <Image src={hero} alt="Autocaravana Benimar Mileo 268 de alquiler en Sevilla" class="hero__bg" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="container hero__in">
      <p class="hero__claim">Tu próxima escapada empieza aquí</p>
      <h1>Alquiler de autocaravanas en Sevilla</h1>
      <p class="hero__lead">Dos Benimar nuevas, con recogida y entrega en Sevilla. Sin intermediarios: te atendemos nosotros, de principio a fin.</p>
      <div class="btn-row hero__btns">
        <a class="btn btn--primary" href="/alquilar-benimar-mileo-268/">Ver autocaravanas <Icon name="arrow" class="i-arrow" /></a>
        <a class="btn btn--outline-light" href="/calendario-disponibilidad/">Consultar disponibilidad</a>
      </div>
    </div>
  </section>

  <!-- MARQUEE + VENTAJAS -->
  <div class="intro">
    <div class="search-wrap">
      <div class="search-card search-card--full">
        <ul class="perks">
          {ventajas.map((v) => (
            <li>
              <Icon name={v.icon} />
              {'href' in v && v.href ? <a href={v.href}>{v.t}</a> : <span>{v.t}</span>}
            </li>
          ))}
        </ul>
        <div class="marquee" role="region" aria-label="Ofertas disponibles" data-offers-marquee>
          <div class="marquee__track">
            {[...marqueeItems, ...marqueeItems].map((item) => (
              <a class="marquee__item" href="/ofertas-alquiler-autocaravana-sevilla/">
                <Icon name="star" />
                <span>{item}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- OFERTAS -->
  <section class="section section--sand offers-sec" aria-labelledby="ofertas-t" data-offers-wrap hidden={activeOffers.length === 0}>
    <div class="container">
      <div class="offers-head">
        <h2 id="ofertas-t">Ofertas del momento</h2>
        <a class="more-link" href="/ofertas-alquiler-autocaravana-sevilla/">Ver todas las ofertas <Icon name="arrow" /></a>
      </div>
      <div class="offers" data-offers>
        <template>
          <a class="offer" href="/ofertas-alquiler-autocaravana-sevilla/" data-vehicle="camper">
            <span class="offer__model" data-f="vehicle"></span>
            <span class="offer__media" aria-hidden="true">
              <img class="offer__photo" data-for="camper" src={offerPhotos.camper.src} width={offerPhotos.camper.attributes.width} height={offerPhotos.camper.attributes.height} alt="" loading="lazy" decoding="async" />
              <img class="offer__photo" data-for="mileo" src={offerPhotos.mileo.src} width={offerPhotos.mileo.attributes.width} height={offerPhotos.mileo.attributes.height} alt="" loading="lazy" decoding="async" />
            </span>
            <span class="offer__body">
              <span class="offer__tag"><Icon name="star" /> Oferta</span>
              <strong class="offer__title" data-f="title"></strong>
              <span class="offer__text" data-f="text"></span>
              <span class="offer__until" data-f="until"></span>
              <span class="offer__cta">Reservar esta oferta <Icon name="arrow" /></span>
            </span>
            <span class="offer__stamp">
              <small class="offer__veh" data-f="vehicle"></small>
              <span class="offer__from">desde</span>
              <b><span data-f="amount"></span>€</b>
              <small>/día</small>
            </span>
          </a>
        </template>
        {activeOffers.map((o) => (
          <a class="offer" href="/ofertas-alquiler-autocaravana-sevilla/" data-vehicle={offerVehicleId(o.vehicle)}>
            <span class="offer__model" hidden={!o.vehicle}>{o.vehicle}</span>
            <span class="offer__media" aria-hidden="true">
              <img class="offer__photo" data-for="camper" src={offerPhotos.camper.src} width={offerPhotos.camper.attributes.width} height={offerPhotos.camper.attributes.height} alt="" loading="lazy" decoding="async" />
              <img class="offer__photo" data-for="mileo" src={offerPhotos.mileo.src} width={offerPhotos.mileo.attributes.width} height={offerPhotos.mileo.attributes.height} alt="" loading="lazy" decoding="async" />
            </span>
            <span class="offer__body">
              <span class="offer__tag"><Icon name="star" /> Oferta</span>
              <strong class="offer__title">{o.title}</strong>
              <span class="offer__text">{o.text}</span>
              <span class="offer__until" hidden={!untilLabel(o.until)}>{untilLabel(o.until)}</span>
              <span class="offer__cta">Reservar esta oferta <Icon name="arrow" /></span>
            </span>
            <span class="offer__stamp" hidden={!o.price}>
              <small class="offer__veh" hidden={!o.vehicle}>{o.vehicle}</small>
              <span class="offer__from">desde</span>
              <b><span>{o.price}</span>€</b>
              <small>/día</small>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BUSCADOR -->
  <section class="section section--sand search-sec" id="buscar-disponibilidad" aria-labelledby="buscar-t">
    <div class="container">
      <div class="contact-cta" role="group" aria-label="Contacto rápido">
        <p class="contact-cta__t">¿Tienes dudas? Pregunta sin compromiso</p>
        <div class="contact-cta__actions">
          <a class="contact-cta__link" href={`tel:${site.phone}`}><Icon name="phone" /> {site.phoneDisplay}</a>
          <span class="contact-cta__sep" aria-hidden="true"></span>
          <a class="btn contact-cta__wa" href={waLink('Hola, quiero consultar disponibilidad')} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
          <span class="contact-cta__sep" aria-hidden="true"></span>
          <a class="contact-cta__link" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
        </div>
      </div>
      <div class="section-head">
        <h2 id="buscar-t">Cuando quieres salir, consulta disponibilidad</h2>
        <p class="lead">Elige fechas y vehículo: te llevamos al calendario para confirmar disponibilidad.</p>
      </div>
      <div class="search-card search-card--solo">
        <form class="search" action="/calendario-disponibilidad/#presupuesto" method="get" aria-label="Buscar disponibilidad">
          <label class="search__f">
            <span>Vehículo</span>
            <select name="modelo">
              <option value="">Cualquier vehículo</option>
              {vehicles.map((v) => <option value={v.id}>{v.name}</option>)}
            </select>
          </label>
          <label class="search__f">
            <span>Recogida</span>
            <input type="date" name="salida" />
          </label>
          <label class="search__f">
            <span>Devolución</span>
            <input type="date" name="llegada" />
          </label>
          <button class="btn btn--primary search__go" type="submit"><Icon name="calendar" /> Buscar disponibilidad</button>
        </form>
      </div>
    </div>
  </section>

  <!-- BANNER -->
  <section class="ritmo" aria-labelledby="ritmo-t">
    <div class="ritmo__copy">
      <h2 id="ritmo-t">Viaja a tu ritmo</h2>
      <p>Para donde quieras, duerme frente al mar o en la sierra y vuelve cuando te apetezca. Tu casa va contigo.</p>
      <a class="btn btn--light" href="/calendario-disponibilidad/">Consultar disponibilidad <Icon name="arrow" class="i-arrow" /></a>
    </div>
    <Image src={imgBanner} alt="Autocaravana Benimar en una carretera de montaña al atardecer" class="ritmo__img" widths={[700, 1100, 1536]} sizes="(max-width: 860px) 100vw, 50vw" />
  </section>

  <!-- GALERÍA -->
  <PhotoCarousel />

  <!-- PARA CADA PLAN -->
  <section class="section section--sand plans-sec">
    <div class="container plans-sec__in">
      <div class="section-head plans-sec__head">
        <h2>Fin de semana, puente o vacaciones: tú decides</h2>
        <p class="lead">Alquiler mínimo de 3 días (para eventos especiales, consúltanos). Sevilla está a menos de 2 horas de la costa, la sierra y Portugal.</p>
      </div>
      <div class="plans">
        {planes.map((p) => (
          <a class="plan" href={p.href}>
            <span class="plan__ic">
              <Image src={p.img} alt="" widths={[320, 560, 800]} sizes="(max-width: 520px) 88px, (max-width: 1080px) 45vw, 280px" />
            </span>
            <strong>{p.t}</strong>
            <span class="plan__d">{p.d}</span>
            <span class="plan__go">Ver más <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- OPINIONES -->
  <section class="section section--sand">
    <div class="container reviews">
      <div class="reviews__head">
        <h2>Opiniones de nuestros viajeros</h2>
        <p class="lead">La satisfacción de quienes ya han viajado con RG MEGA es lo que más nos motiva.</p>
      </div>
      <Reviews />
    </div>
  </section>

  <!-- ESCAPADAS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Escapadas que apetece vivir</h2>
        <p class="lead">Ideas de rutas desde Sevilla para disfrutar en autocaravana.</p>
      </div>
      <div class="dest">
        {destinos.map((d) => (
          <a class="dest__card" href={d.href}>
            <Image src={d.img} alt={`Autocaravana en ruta: ${d.name}`} widths={[420, 700]} sizes="(max-width: 760px) 100vw, 380px" />
            <span class="dest__txt"><strong>{d.name}</strong><span>{d.d}</span></span>
          </a>
        ))}
      </div>
      <p class="more"><a href="/rutas/">Ver todas las rutas <Icon name="arrow" /></a></p>
    </div>
  </section>

  <Location />

  <!-- DUDAS -->
  <section class="section">
    <div class="narrow">
      <div class="section-head">
        <h2>Dudas frecuentes</h2>
        <p class="lead">Lo que más nos preguntáis antes de reservar.</p>
      </div>
      <FaqList items={faqsBy('home', 8)} />
      <p class="more"><a href="/preguntas-frecuentes/">Ver todas las preguntas frecuentes <Icon name="arrow" /></a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Buscador: fechas mínimas
  const f = document.querySelector<HTMLFormElement>('form.search');
  if (f) {
    const a = f.querySelector<HTMLInputElement>('[name=salida]')!, b = f.querySelector<HTMLInputElement>('[name=llegada]')!;
    const t = new Date(); t.setMinutes(t.getMinutes() - t.getTimezoneOffset());
    a.min = b.min = t.toISOString().slice(0, 10);
    a.addEventListener('change', () => { b.min = a.value || a.min; if (b.value && b.value < a.value) b.value = ''; });
    // No enviar parámetros vacíos
    f.addEventListener('submit', () => f.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[name]').forEach((el) => { el.disabled = !el.value; }));
    addEventListener('pageshow', () => f.querySelectorAll<HTMLInputElement>('[name]').forEach((el) => { el.disabled = false; }));
  }
</script>

<style>
  /* HERO */
  .hero { position: relative; color: #fff; overflow: hidden; isolation: isolate; min-height: clamp(520px, 78vh, 720px); display: flex; align-items: center; }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(90deg, rgba(20,32,26,.82) 0%, rgba(20,32,26,.55) 42%, rgba(20,32,26,.08) 75%),
    linear-gradient(0deg, rgba(20,32,26,.55) 0%, transparent 35%),
    linear-gradient(180deg, rgba(250,176,44,.18), transparent 40%); }
  .hero__in { padding: clamp(56px, 8vw, 96px) 0 clamp(96px, 12vw, 140px); }
  .hero__claim { font-family: var(--display); font-weight: 700; font-size: clamp(2.5rem, 6.2vw, 4.6rem); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 .6rem; max-width: 12ch; text-wrap: balance; }
  .hero h1 { color: #fff; font-size: clamp(1.2rem, 2.2vw, 1.6rem); font-weight: 600; margin: 0 0 .9rem; letter-spacing: 0; }
  .hero__lead { font-size: 1.08rem; color: var(--on-dark); max-width: 46ch; margin: 0 0 1.6rem; }
  .hero__btns { margin-bottom: 0; }
  .hero__btns .btn--primary { border-color: #fff; }

  /* MARQUEE + VENTAJAS */
  .search-wrap { position: relative; z-index: 2; margin-top: -64px; width: 100%; }
  .search-card { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow-lg); overflow: hidden; }
  .search-card--full { border-radius: 0; box-shadow: 0 18px 40px -24px rgba(23,53,40,.45); background: var(--forest); }
  .search-card--solo { background: #fff; }
  .marquee { overflow: hidden; background: var(--forest); padding: 1.05rem 0; border-top: 1px solid rgba(255,255,255,.18); mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent); }
  .marquee__track { display: flex; width: max-content; gap: 2.75rem; animation: marquee 28s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__item { display: inline-flex; align-items: center; gap: .55rem; white-space: nowrap; font-weight: 700; font-size: 1.05rem; color: #fff; text-decoration: none; }
  .marquee__item:hover { color: var(--sub); }
  .marquee__item :global(svg) { width: 16px; height: 16px; color: var(--terra); flex: none; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; padding-inline: 1rem; }
  }
  .search { display: grid; grid-template-columns: 1.2fr 1fr 1fr auto; gap: 1rem; align-items: end; padding: 1.3rem 1.4rem 1.2rem; }
  .search__f { display: grid; gap: .35rem; font-size: .85rem; font-weight: 650; color: var(--ink); }
  .search__f select, .search__f input { width: 100%; padding: .75em .9em; border: 1.5px solid var(--line); border-radius: 10px; font: inherit; font-weight: 500; font-size: .95rem; background: #fff; color: var(--ink); }
  .search__f select:focus, .search__f input:focus { outline: none; border-color: var(--forest); box-shadow: 0 0 0 4px rgba(31,74,56,.12); }
  .search__go { height: 48px; }
  .search-sec { padding-block: clamp(48px, 6vw, 72px); }
  .contact-cta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 1.5rem;
    background: var(--forest); color: #fff; border-radius: var(--radius); padding: 1.15rem 1.4rem;
    margin-bottom: 1.6rem; box-shadow: var(--shadow);
  }
  .contact-cta__t { margin: 0; font-family: var(--display); font-weight: 700; font-size: 1.15rem; color: #fff; }
  .contact-cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.1rem; }
  .contact-cta__link { display: inline-flex; align-items: center; gap: .45rem; color: #fff; text-decoration: none; font-weight: 650; font-size: .98rem; }
  .contact-cta__link:hover { color: var(--sub); }
  .contact-cta__link :global(svg) { width: 20px; height: 20px; color: var(--terra); flex: none; }
  .contact-cta__wa { background: #fff; color: var(--forest); padding: .55em 1em; font-size: .95rem; }
  .contact-cta__wa:hover { background: var(--sand); color: var(--forest); }
  .contact-cta__wa :global(svg) { color: var(--wa); }
  .contact-cta__sep { width: 1px; height: 28px; background: rgba(255,255,255,.3); flex: none; }
  @media (max-width: 720px) {
    .contact-cta { flex-direction: column; align-items: flex-start; }
    .contact-cta__sep { display: none; }
  }
  .perks { list-style: none; margin: 0; padding: 1.05rem clamp(1rem, 3vw, 2rem); display: grid; grid-template-columns: repeat(4, 1fr); background: var(--forest); }
  .perks li { display: flex; align-items: center; justify-content: center; gap: .65rem; padding: .35rem 1rem; font-weight: 600; font-size: 1rem; color: #fff; }
  .perks li + li { border-left: 1px solid rgba(255,255,255,.22); }
  .perks a { color: #fff; text-decoration: none; }
  .perks a:hover { color: var(--sub); }
  .perks :global(svg) { width: 26px; height: 26px; color: var(--terra); flex: none; stroke-width: 1.8; }

  /* SEPARACIÓN DEL BLOQUE INICIAL */
  .intro { background: #fff; padding-bottom: clamp(2.5rem, 5vw, 4rem); position: relative; z-index: 1; width: 100%; }

  /* OFERTAS */
  .offers-sec { padding-block: clamp(56px, 7vw, 88px); }
  .offers-sec[hidden] { display: none; }
  .offers-sec > .container { width: min(100% - 24px, 1480px); }
  .offers-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; margin-bottom: 1.4rem; }
  .offers-head h2 { margin: 0; }
  .more-link { display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; color: var(--forest); text-decoration: none; }
  .more-link :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .more-link:hover :global(svg) { transform: translateX(3px); }
  .offers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem; }
  .offer { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "model model" "media media" "body stamp"; align-items: center; gap: 0; border-radius: var(--radius); color: #fff; text-decoration: none;
    background: radial-gradient(120% 140% at 100% 0%, rgba(250,176,44,.38) 0%, rgba(250,176,44,0) 48%), linear-gradient(135deg, var(--forest) 0%, var(--forest-2) 100%);
    box-shadow: 0 18px 40px -22px rgba(23,53,40,.8); transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s; }
  .offer::before { content: ''; position: absolute; z-index: -1; right: -60px; bottom: -70px; width: 260px; height: 260px; border-radius: 50%; border: 2px dashed rgba(255,255,255,.12); }
  .offer:hover { color: #fff; transform: translateY(-3px); box-shadow: 0 26px 50px -24px rgba(23,53,40,.9); }
  .offer__model { grid-area: model; padding: .85rem 1.35rem .55rem; font-family: var(--display); font-weight: 700; font-size: 1.05rem; letter-spacing: .02em; color: #fff; }
  .offer__model:empty, .offer__model[hidden] { display: none; }
  .offer__media { grid-area: media; position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--forest-2); }
