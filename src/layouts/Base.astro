---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '../data/remote'; // lee Google Sheets al compilar
import { site } from '../data/site';
import { vehicles, fromPrice, px } from '../data/vehicles';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; url: string }[];
}
const { image = '/og-alquiler-autocaravanas-sevilla.jpg', schema = [], breadcrumbs } = Astro.props;
// Copia temporal en GitHub Pages: nunca indexar (la web oficial es autocaravanasrgmega.com)
const noindex = Astro.props.noindex || process.env.GH_PAGES === '1';
const title = px(Astro.props.title);
const description = px(Astro.props.description);
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': ['AutoRental', 'LocalBusiness'],
  '@id': `${site.url}/#negocio`,
  name: site.name,
  alternateName: ['Autocaravanas RG MEGA', 'RG MEGA Alquiler de autocaravanas Sevilla'],
  url: site.url + '/',
  logo: `${site.url}/favicon.png`,
  image: ogImage,
  telephone: site.phone,
  email: site.email,
  priceRange: px('{all.desde}€ - {all.max}€ / día'),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: [
    { '@type': 'City', name: 'Sevilla' },
    { '@type': 'AdministrativeArea', name: 'Aljarafe' },
    { '@type': 'AdministrativeArea', name: 'Andalucía' },
  ],
  hasMap: site.mapsUrl,
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: site.hoursSchema.opens,
    closes: site.hoursSchema.closes,
  }],
  sameAs: Object.values(site.social),
  makesOffer: vehicles.map((v) => ({
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: fromPrice(v),
    priceSpecification: { '@type': 'UnitPriceSpecification', price: fromPrice(v), priceCurrency: 'EUR', unitText: 'DAY' },
    itemOffered: { '@type': 'Product', name: `Alquiler ${v.name} en Sevilla`, url: site.url + v.slug },
  })),
};

const crumbsSchema = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Inicio', url: '/' }, ...breadcrumbs].map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.url, site.url).href,
  })),
};
const allSchema = [business, ...(crumbsSchema ? [crumbsSchema] : []), ...schema];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#3C5F4D" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="geo.region" content="ES-SE" />
  <meta name="geo.placename" content="Salteras, Sevilla" />
  {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip visually-hidden" href="#main">Saltar al contenido</a>
  <Header />
  <main id="main">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <slot />
  </main>
  <Footer />
  <MobileBar />
  <script>import '../scripts/live';</script>
</body>
</html>
