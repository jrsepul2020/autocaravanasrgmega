---
import Icon from './Icon.astro';
const items = [
  { icon: 'shield', t: 'Seguro y asistencia 24 h', d: 'Incluidos en el precio. Viaja tranquilo por España y Portugal.' },
  { icon: 'parking', t: 'Parking gratis para tu coche', d: 'Cerrado y cubierto mientras estás de viaje.' },
  { icon: 'paw', t: 'Mascotas gratis', d: 'Tu perro también se viene, sin suplementos.' },
  { icon: 'clock', t: 'Recogida flexible', d: 'De 9:00 a 22:00, también fines de semana y festivos.' },
  { icon: 'key', t: 'Todo equipado', d: 'Menaje, mesa y sillas, gas, manguera, kit de limpieza…' },
  { icon: 'headset', t: 'Trato directo', d: 'Hablas siempre con nosotros, no con una centralita.' },
];
---
<ul class="bf">
  {items.map((i) => (
    <li><span class="bf__i"><Icon name={i.icon} /></span><div><strong>{i.t}</strong><p>{i.d}</p></div></li>
  ))}
</ul>
<style>
  .bf { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.6rem 2rem; }
  .bf li { display: flex; gap: 1rem; align-items: flex-start; }
  .bf__i { width: 52px; height: 52px; flex: none; border-radius: 16px; display: grid; place-items: center; background: var(--pine-dark); color: var(--sub); box-shadow: var(--shadow); }
  .bf__i :global(svg) { width: 26px; height: 26px; }
  .bf li:nth-child(3n+2) .bf__i { background: var(--price); color: #fff; }
  .bf li:nth-child(3n) .bf__i { background: var(--pine-2); color: #fff; }
  .bf strong { display: block; color: var(--pine); font-size: 1.05rem; margin-bottom: .15rem; }
  .bf p { margin: 0; color: var(--muted); font-size: .95rem; }
  :global(.section--pine) .bf__i { background: rgba(250,176,44,.14); color: var(--sub); box-shadow: inset 0 0 0 1px rgba(250,176,44,.3); }
  :global(.section--pine) .bf li:nth-child(3n+2) .bf__i { background: var(--price); color: #fff; box-shadow: 0 8px 20px -8px rgba(60,95,77,.7); }
  :global(.section--pine) .bf li:nth-child(3n) .bf__i { background: rgba(255,255,255,.1); color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.18); }
  :global(.section--pine) .bf strong { color: #fff; }
  :global(.section--pine) .bf p { color: var(--on-dark); }
</style>
