---
/** "Datos clave": resumen citable para personas y buscadores con IA. */
import Icon from './Icon.astro';
import { keyFacts } from '../data/facts';
interface Props { title?: string; only?: string[] }
const { title = 'RG MEGA en 30 segundos', only } = Astro.props;
const icons: Record<string, string> = { Qué: 'key', Dónde: 'pin', Precio: 'euro', Mínimo: 'calendar', Kilómetros: 'route', Incluido: 'shield', Requisitos: 'users', Horario: 'clock', Contacto: 'phone' };
const facts = keyFacts().filter((f) => !only || only.includes(f.k));
const updated = new Date().toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
---
<section class="kf" aria-labelledby="kf-t">
  <div class="kf__head">
    <h2 id="kf-t">{title}</h2>
    <p>Lo esencial para alquilar con nosotros. Datos actualizados en <time datetime={new Date().toISOString().slice(0, 10)}>{updated}</time>.</p>
  </div>
  <dl class="kf__list">
    {facts.map((f) => (
      <div class="kf__item">
        <span class="kf__ic" aria-hidden="true"><Icon name={icons[f.k] ?? 'check'} /></span>
        <dt>{f.k}</dt>
        <dd>{f.v}</dd>
      </div>
    ))}
  </dl>
</section>
<style>
  .kf__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .4rem 2rem; margin-bottom: 2rem; }
  .kf__head h2 { margin: 0; font-size: clamp(1.75rem, 3.4vw, 2.4rem); }
  .kf__head p { margin: 0; color: var(--muted); max-width: 46ch; }
  .kf__list { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 0 2.5rem; }
  .kf__item { display: grid; grid-template-columns: 44px minmax(0, 1fr); column-gap: .9rem; row-gap: .15rem; align-content: start; padding: 1.3rem 0; border-top: 1px solid var(--line); }
  .kf__ic { grid-row: 1 / span 2; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--sand-2); color: var(--forest); }
  .kf__ic :global(svg) { width: 22px; height: 22px; }
  dt { font-size: .76rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--forest); padding-top: .15rem; }
  dd { margin: 0; font-size: .95rem; line-height: 1.5; color: var(--ink); overflow-wrap: anywhere; }
  .kf__item > * { min-width: 0; }
</style>
