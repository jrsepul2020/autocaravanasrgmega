---
/**
 * Calendario de disponibilidad y precios, conectado a Google Calendar.
 *
 * CÓMO SE GESTIONA (admin): en Google Calendar, en el calendario de cada vehículo,
 * crea un evento de día completo (p. ej. "RESERVADA MILEO") que cubra los días ocupados.
 * Se marca en rojo automáticamente. Los eventos con "DISPONIBLE" o "LIBRE" en el título se ignoran.
 *
 * - Muestra también los 3 meses anteriores con sus reservas (se puede navegar hacia atrás).
 * - Cada día lleva su precio orientativo por día (tramo de 3–4 días del periodo).
 * - Los días con tarifa especial (puentes, Navidad…) llevan una marca.
 * - Las tarifas se actualizan en vivo desde Google Sheets (pestañas Tarifas y Tarifas especiales).
 * - summary: muestra el panel "Resumen de tu reserva" con el precio calculado.
 */
import Icon from './Icon.astro';
import { site, priceDisclaimer } from '../data/site';
import type { Vehicle } from '../data/vehicles';
interface Props { vehicle: Vehicle; months?: number; summary?: boolean }
const { vehicle, months = 2, summary = false } = Astro.props;
const embed = `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(vehicle.calendarId)}&ctz=Europe%2FMadrid&mode=MONTH&showTitle=0&showPrint=0&showTabs=0&showCalendars=0&hl=es`;
const data = JSON.stringify({ name: vehicle.name, short: vehicle.short, wa: site.whatsapp });
---
<div class:list={['avc', { 'avc--summary': summary }]} data-cal={vehicle.calendarId} data-key={site.googleApiKey} data-months={months} data-model={vehicle.id} data-embed={embed} data-info={data}>
  <div class="avc__main">
    <div class="avc__top">
      <button type="button" class="avc__nav" data-prev aria-label="Meses anteriores"><Icon name="arrow" /></button>
      <p class="avc__range" data-range></p>
      <button type="button" class="avc__nav" data-next aria-label="Meses siguientes"><Icon name="arrow" /></button>
    </div>
    <div class="avc__months" aria-live="polite"><p class="avc__loading">Cargando disponibilidad…</p></div>
    <div class="avc__legend">
      <span><i class="free"></i> Libre</span>
      <span><i class="busy"></i> Reservado</span>
      <span><i class="past"></i> Pasado</span>
      <span><i class="sel"></i> Tu selección</span>
      <span><i class="pk"></i> Tarifa especial</span>
      <span class="avc__legend-note">Precio orientativo por día (alquiler de 3–4 días)</span>
    </div>
  </div>

  {summary ? (
    <aside class="avc__sum" aria-live="polite">
      <div class="avc__sum-head">
        <span class="avc__sum-ic"><Icon name="calendar" /></span>
        <div><p class="avc__sum-t">Resumen de tu reserva</p><p class="avc__sum-s">{vehicle.name}</p></div>
      </div>
      <div class="avc__box">
        <p class="avc__box-h">Fechas</p>
        <p data-sum-dates>Elige en el calendario el día de recogida y el de devolución.</p>
      </div>
      <div class="avc__box avc__box--price">
        <p class="avc__box-h">Precio orientativo</p>
        <ul class="avc__lines" data-sum-lines><li><span>Sin fechas seleccionadas</span><span>—</span></li></ul>
        <p class="avc__total"><span>Total</span><strong data-sum-total>0 €</strong></p>
        <p class="avc__km" data-sum-km></p>
        <p class="avc__warn" data-sum-warn hidden></p>
      </div>
      <p class="avc__disc">{priceDisclaimer}</p>
      <a class="btn btn--primary avc__go" data-pick-go href="#" aria-disabled="true">Pedir esta reserva <Icon name="arrow" class="i-arrow" /></a>
      <a class="btn btn--wa avc__wa" data-pick-wa href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> Consultar por WhatsApp</a>
      <button type="button" class="avc__clear" data-clear hidden>Borrar selección</button>
    </aside>
  ) : (
    <div class="avc__pick" hidden>
      <p data-pick-text></p>
      <a class="btn btn--primary btn--sm" data-pick-go href="#">Consultar estas fechas</a>
    </div>
  )}
</div>

<script>
  import { quote, dayRate, packsOn, condition, tierLabel, type VehicleId } from '../data/rates';
  import { currentRates } from '../scripts/rates-client';
  type Range = [string, string];
  const pad = (n: number) => String(n).padStart(2, '0');
  const iso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const MONTHS = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const BACK = 3;      // meses hacia atrás visibles
  const AHEAD = 14;    // meses hacia delante
  const eur = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' €';
  const fmt = (s: string) => new Date(s + 'T12:00:00').toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' });

  async function loadBusy(cal: string, key: string): Promise<Range[]> {
    const min = new Date(); min.setDate(1); min.setMonth(min.getMonth() - BACK); min.setHours(0, 0, 0, 0);
    const max = new Date(); max.setDate(1); max.setMonth(max.getMonth() + AHEAD);
    const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(cal)}/events?key=${key}&singleEvents=true&maxResults=2500&timeMin=${min.toISOString()}&timeMax=${max.toISOString()}`;
    const res = await fetch(url);
    if (!res.ok) throw new Error('gcal ' + res.status);
    const j = await res.json();
    return (j.items || []).filter((e: any) => e.status !== 'cancelled' && !/libre|disponible/i.test(e.summary || '')).map((e: any) => {
      if (e.start.date) { // día completo: end exclusivo
        const end = new Date(e.end.date + 'T00:00:00'); end.setDate(end.getDate() - 1);
        return [e.start.date, iso(end)] as Range;
      }
      return [e.start.dateTime.slice(0, 10), e.end.dateTime.slice(0, 10)] as Range;
    });
  }

  document.querySelectorAll<HTMLElement>('.avc').forEach(async (el) => {
    const info = JSON.parse(el.dataset.info!);
    const months = Number(el.dataset.months) || 2;
    const hasSummary = el.classList.contains('avc--summary');
    const box = el.querySelector<HTMLElement>('.avc__months')!;
    const today = iso(new Date());
    let offset = 0;
    let busy: Range[] = [];
    let sel: string[] = [];
    const model = el.dataset.model as VehicleId;
    // Tarifas en vivo (Google Sheets)
    window.addEventListener('rg:live', () => { render(); update(); });

    const isBusy = (d: string) => busy.some(([a, b]) => d >= a && d <= b);

    function render() {
      const base = new Date(); base.setDate(1); base.setMonth(base.getMonth() + offset);
      const last = new Date(base.getFullYear(), base.getMonth() + months - 1, 1);
      el.querySelector('[data-range]')!.textContent = months > 1
        ? `${MONTHS[base.getMonth()]} ${base.getFullYear() !== last.getFullYear() ? base.getFullYear() + ' ' : ''}– ${MONTHS[last.getMonth()]} ${last.getFullYear()}`
        : `${MONTHS[base.getMonth()]} ${base.getFullYear()}`;
      let html = '';
      for (let m = 0; m < months; m++) {
        const first = new Date(base.getFullYear(), base.getMonth() + m, 1);
        const days = new Date(first.getFullYear(), first.getMonth() + 1, 0).getDate();
        const lead = (first.getDay() + 6) % 7;
        html += `<div class="avc__month"><p class="avc__mname">${MONTHS[first.getMonth()]} ${first.getFullYear()}</p><div class="avc__grid">`;
        html += ['L','M','X','J','V','S','D'].map((d) => `<span class="avc__dow">${d}</span>`).join('');
        html += '<span></span>'.repeat(lead);
        for (let d = 1; d <= days; d++) {
          const s = iso(new Date(first.getFullYear(), first.getMonth(), d));
          const past = s < today;
          const b = isBusy(s);
          const r = currentRates();
          const price = dayRate(r, model, s);
          const pk = packsOn(r, s).some((p) => p.prices[model]);
          const inSel = sel.length === 2 ? s >= sel[0] && s <= sel[1] : sel[0] === s;
          const edge = sel.length === 2 && (s === sel[0] || s === sel[1]);
          const cls = [past ? 'past' : 'free', b ? 'busy' : '', inSel ? 'sel' : '', edge ? 'edge' : '', s === today ? 'today' : '', pk ? 'pk' : ''].filter(Boolean).join(' ');
          const label = `${d} de ${MONTHS[first.getMonth()]}${b ? ', reservado' : past ? ', pasado' : ', libre'}${price ? `, ${price} € el día` : ''}${pk ? ', tarifa especial' : ''}`;
          html += `<button type="button" class="avc__d ${cls}" data-d="${s}" ${past || b ? 'disabled' : ''} aria-label="${label}"><b>${d}</b><small>${price ? price + '€' : '·'}</small></button>`;
        }
        html += '</div></div>';
      }
      box.innerHTML = html;
      el.querySelector<HTMLButtonElement>('[data-prev]')!.disabled = offset <= -BACK;
      el.querySelector<HTMLButtonElement>('[data-next]')!.disabled = offset >= AHEAD - months;
    }

    function update() {
      const go = el.querySelector<HTMLAnchorElement>('[data-pick-go]')!;
      const form = document.querySelector<HTMLFormElement>('form.qf');
      const params = sel.length === 2 ? new URLSearchParams({ modelo: el.dataset.model!, salida: sel[0], llegada: sel[1] }) : null;
      go.href = !params ? '#' : form ? '#' + form.id : `${import.meta.env.BASE_URL}contacto/?${params}#presupuesto`;
      go.onclick = !params ? (e) => e.preventDefault() : form ? () => {
        (form.querySelector(`[name=modelo][value=${el.dataset.model}]`) as HTMLInputElement).checked = true;
        (form.querySelector('[name=salida]') as HTMLInputElement).value = sel[0];
        (form.querySelector('[name=llegada]') as HTMLInputElement).value = sel[1];
        form.dispatchEvent(new Event('input'));
      } : null;

      if (!hasSummary) {
        const pick = el.querySelector<HTMLElement>('.avc__pick')!;
        if (sel.length < 2) { pick.hidden = true; return; }
        const q = quote(currentRates(), model, sel[0], sel[1]);
        pick.hidden = false;
        el.querySelector('[data-pick-text]')!.textContent = `${fmt(sel[0])} → ${fmt(sel[1])} · ${q.days} ${q.days === 1 ? 'día' : 'días'} · ${q.ok ? eur(q.total) + ' aprox.' : 'pídenos precio'}`;
        return;
      }

      go.setAttribute('aria-disabled', String(sel.length < 2));
      el.querySelector<HTMLElement>('[data-clear]')!.hidden = sel.length === 0;
      const dates = el.querySelector<HTMLElement>('[data-sum-dates]')!;
      const lines = el.querySelector<HTMLElement>('[data-sum-lines]')!;
      const total = el.querySelector<HTMLElement>('[data-sum-total]')!;
      const km = el.querySelector<HTMLElement>('[data-sum-km]')!;
      const warn = el.querySelector<HTMLElement>('[data-sum-warn]')!;
      const wa = el.querySelector<HTMLAnchorElement>('[data-pick-wa]')!;
      if (sel.length === 0) {
        dates.textContent = 'Elige en el calendario el día de recogida y el de devolución.';
        lines.innerHTML = '<li><span>Sin fechas seleccionadas</span><span>—</span></li>';
        total.textContent = '0 €'; km.textContent = ''; warn.hidden = true;
        wa.href = `https://wa.me/${info.wa}?text=${encodeURIComponent(`Hola, quiero consultar disponibilidad de la ${info.name}.`)}`;
        return;
      }
      if (sel.length === 1) {
        dates.innerHTML = `<strong>Recogida:</strong> ${fmt(sel[0])}<br><span class="avc__muted">Ahora elige el día de devolución.</span>`;
        lines.innerHTML = '<li><span>Falta la fecha de devolución</span><span>—</span></li>';
        total.textContent = '0 €'; km.textContent = ''; warn.hidden = true;
        return;
      }
      const rr = currentRates();
      const q = quote(rr, model, sel[0], sel[1]);
      const n = `${q.days} ${q.days === 1 ? 'día' : 'días'}`;
      dates.innerHTML = `<strong>${fmt(sel[0])}</strong> → <strong>${fmt(sel[1])}</strong><br><span class="avc__muted">${n} de alquiler (se cuentan noches)</span>`;
      if (q.ok) {
        lines.innerHTML = q.pack
          ? `<li><span>${q.pack.name} <em>(precio cerrado)</em></span><span>${eur(q.total)}</span></li>`
          : `<li><span>${n} × ${q.perDay} € <em>(tarifa ${tierLabel(q.tier)})</em></span><span>${eur(q.total)}</span></li>`;
        total.textContent = eur(q.total);
      } else {
        lines.innerHTML = '<li><span>Aún no hay tarifa publicada para estas fechas</span><span>—</span></li>';
        total.textContent = 'Consultar';
      }
      const kmTxt = condition(rr, 'kilometros'), exc = condition(rr, 'exceso');
      km.textContent = [kmTxt, exc && `exceso ${exc}`].filter(Boolean).join(' · ');
      const ov = q.ok ? q.overlapsPack : undefined;
      warn.hidden = !ov;
      warn.textContent = ov ? `Tus fechas coinciden con «${ov.name}», que tiene tarifa especial: pregúntanos.` : '';
      wa.href = `https://wa.me/${info.wa}?text=${encodeURIComponent(`Hola, quiero reservar la ${info.name} del ${sel[0].split('-').reverse().join('/')} al ${sel[1].split('-').reverse().join('/')} (${n}${q.ok ? `, ${eur(q.total)} aprox.` : ''}). ¿Está disponible?`)}`;
    }

    box.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLButtonElement>('.avc__d');
      if (!t || t.disabled) return;
      const d = t.dataset.d!;
      if (sel.length !== 1 || d < sel[0]) sel = [d];
      else {
        const crosses = busy.some(([a, b]) => a <= d && b >= sel[0]); // no cruzar días reservados
        sel = crosses ? [d] : [sel[0], d];
      }
      render(); update();
    });
    el.querySelector('[data-clear]')?.addEventListener('click', () => { sel = []; render(); update(); });
    el.querySelector('[data-prev]')!.addEventListener('click', () => { offset = Math.max(-BACK, offset - 1); render(); });
    el.querySelector('[data-next]')!.addEventListener('click', () => { offset = Math.min(AHEAD - months, offset + 1); render(); });

    try {
      busy = await loadBusy(el.dataset.cal!, el.dataset.key!);
      render(); update();
    } catch {
      // Plan B: calendario público de Google embebido
      box.innerHTML = `<iframe src="${el.dataset.embed}" title="Disponibilidad" loading="lazy" style="border:0;width:100%;height:520px"></iframe>`;
      el.querySelector('.avc__top')!.setAttribute('hidden', '');
      el.querySelector('.avc__legend')!.setAttribute('hidden', '');
    }
  });
</script>

<style>
  .avc { display: grid; gap: 1.5rem; align-items: start; }
  .avc--summary { grid-template-columns: minmax(0, 1fr) 340px; }
  .avc__main { background: #fff; border-radius: var(--radius); padding: 1.2rem; box-shadow: 0 0 0 1px var(--line), var(--shadow); min-width: 0; }
  .avc__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .avc__range { margin: 0; font-family: var(--display); font-weight: 700; font-size: 1.1rem; color: var(--forest); text-transform: capitalize; text-align: center; }
  .avc__nav { width: 40px; height: 40px; border-radius: 10px; border: 0; background: var(--forest); color: #fff; cursor: pointer; display: grid; place-items: center; }
  .avc__nav :global(svg) { width: 18px; height: 18px; }
  .avc__nav[data-prev] :global(svg) { transform: rotate(180deg); }
  .avc__nav:disabled { opacity: .3; cursor: default; }
  .avc__months { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: 1.2rem; min-height: 280px; }
  .avc__loading { color: var(--muted); }
  :global(.avc__month) { border-radius: 12px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); }
  :global(.avc__mname) { margin: 0; padding: .7rem; background: var(--forest); color: #fff; text-align: center; font-family: var(--display); font-weight: 700; text-transform: uppercase; letter-spacing: .05em; font-size: .95rem; }
  :global(.avc__grid) { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; padding: .6rem; }
  :global(.avc__dow) { text-align: center; font-size: .72rem; font-weight: 700; color: var(--muted); padding: .2rem 0 .3rem; }
  :global(.avc__d) { border: 0; border-radius: 8px; font: inherit; cursor: pointer; display: grid; place-content: center; gap: 1px; padding: .35rem 0; min-height: 48px; line-height: 1.1; transition: transform .12s, background .15s; }
  :global(.avc__d b) { font-size: .92rem; font-weight: 700; }
  :global(.avc__d small) { font-size: .66rem; font-weight: 700; }
  /* Libre: verde claro con borde; precio en ámbar oscuro (5,1:1) para que destaque */
  :global(.avc__d.free) { background: #E6F3EA; color: var(--ink); box-shadow: inset 0 0 0 1px #B7D8C3; }
  :global(.avc__d.free small) { color: #A84E08; font-size: .7rem; font-weight: 800; }
  :global(.avc__d.free:hover) { background: #fff; box-shadow: inset 0 0 0 2px var(--forest); transform: translateY(-1px); }
  :global(.avc__d.busy) { background: #e0475b; color: #fff; cursor: not-allowed; }
  :global(.avc__d.busy small) { color: #fff; opacity: .9; }
  /* Pasado: sin fondo ni borde, en gris tenue */
  :global(.avc__d.past) { background: transparent; color: #B3BBB7; cursor: default; box-shadow: none; }
  :global(.avc__d.past b) { font-weight: 500; }
  :global(.avc__d.past small) { color: #C3CAC6; font-weight: 500; }
  :global(.avc__d.past.busy) { background: #F6DADE; color: #C98A93; }
  :global(.avc__d.past.busy small) { color: #C98A93; }
  :global(.avc__d.pk) { position: relative; }
  :global(.avc__d.pk)::after { content: ''; position: absolute; top: 4px; right: 4px; width: 6px; height: 6px; border-radius: 50%; background: var(--terra); }
  :global(.avc__d.today) { box-shadow: inset 0 0 0 2px var(--terra); }
  :global(.avc__d.sel) { background: var(--pine) !important; color: #fff !important; box-shadow: none; }
  :global(.avc__d.sel small) { color: #fff !important; }
  :global(.avc__d.edge) { background: var(--forest) !important; }
  .avc__legend { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.1rem; font-size: .82rem; color: var(--muted); margin-top: 1rem; }
  .avc__legend i { display: inline-block; width: 14px; height: 14px; border-radius: 4px; vertical-align: -2px; margin-right: .3rem; }
  .avc__legend .free { background: #E6F3EA; box-shadow: inset 0 0 0 1px #B7D8C3; } .avc__legend .busy { background: #e0475b; } .avc__legend .past { background: #fff; box-shadow: inset 0 0 0 1px #D5DBD8; } .avc__legend .sel { background: var(--forest); } .avc__legend .pk { width: 8px; height: 8px; border-radius: 50%; background: var(--terra); vertical-align: 1px; }
  .avc__legend-note { margin-left: auto; font-style: italic; }

  /* Resumen */
  .avc__sum { position: sticky; top: 96px; display: grid; gap: .8rem; background: #fff; border-radius: var(--radius); padding: 1.2rem; box-shadow: 0 0 0 1px var(--line), var(--shadow-lg); }
  .avc__sum-head { display: flex; gap: .8rem; align-items: center; }
  .avc__sum-ic { width: 42px; height: 42px; border-radius: 10px; display: grid; place-items: center; background: var(--forest); color: #fff; flex: none; }
  .avc__sum-ic :global(svg) { width: 20px; height: 20px; }
  .avc__sum-t { margin: 0; font-family: var(--display); font-weight: 700; font-size: 1.15rem; color: var(--ink); }
  .avc__sum-s { margin: 0; font-size: .85rem; color: var(--muted); }
  .avc__box { border-radius: 12px; padding: .85rem 1rem; box-shadow: inset 0 0 0 1px var(--line); font-size: .92rem; }
  .avc__box p { margin: 0; }
  .avc__box--price { background: var(--sand); }
  .avc__box-h { font-size: .72rem !important; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--pine); margin-bottom: .4rem !important; }
  .avc__lines { list-style: none; padding: 0; margin: 0 0 .6rem; display: grid; gap: .3rem; }
  .avc__lines :global(li) { display: flex; justify-content: space-between; gap: .8rem; font-size: .88rem; }
  .avc__lines :global(em) { font-style: normal; color: var(--muted); }
  .avc__total { display: flex; justify-content: space-between; align-items: baseline; padding: .6rem .8rem; background: #fff; border-radius: 10px; box-shadow: 0 0 0 1px var(--line); }
  .avc__total strong { font-family: var(--display); font-size: 1.6rem; color: var(--pine); }
  .avc__km { font-size: .8rem !important; color: var(--muted); margin-top: .45rem !important; }
  .avc__warn { font-size: .82rem !important; font-weight: 700; color: var(--ink); margin-top: .35rem !important; padding-left: .6rem; box-shadow: inset 3px 0 0 var(--terra); }
  .avc__disc { margin: 0; font-size: .78rem; color: var(--muted); }
  :global(.avc__muted) { color: var(--muted); font-size: .85rem; }
  .avc__go[aria-disabled='true'] { opacity: .45; pointer-events: none; }
  .avc__go, .avc__wa { width: 100%; }
  .avc__clear { border: 0; background: none; color: var(--muted); font: inherit; font-size: .85rem; text-decoration: underline; cursor: pointer; }

  .avc__pick { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem; padding: .8rem 1rem; background: var(--sand); border-radius: 12px; box-shadow: inset 0 0 0 1px var(--line); }
  .avc__pick p { margin: 0; font-weight: 650; color: var(--pine); }

  @media (max-width: 1020px) {
    .avc--summary { grid-template-columns: minmax(0, 1fr); }
    .avc__sum { position: static; }
    .avc__legend-note { margin-left: 0; }
  }
</style>
