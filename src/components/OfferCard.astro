---
/**
 * Tarjeta de oferta con aspecto de rebaja: sello con el % de descuento, precio anterior tachado,
 * precio de oferta en grande y aviso de "Quedan X días".
 * Sin `o` se pinta vacía para usarla como <template> (la rellena src/scripts/live.ts con data-f).
 */
import { getImage } from 'astro:assets';
import { getVehicle } from '../data/vehicles';
import { offerDeal, offerLeft, offerVehicleId, type Offer } from '../data/sheet';
import { fromPrice } from '../data/vehicles';

interface Props { o?: Offer }
const { o } = Astro.props;
const vid = o ? offerVehicleId(o.vehicle) : 'camper';
const deal = o ? offerDeal(o.price, o.antes, fromPrice(getVehicle(vid))) : null;
const untilLabel = (d: string) => (d && d < '2999' ? `Válida hasta el ${new Date(d + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })}` : '');
const v = {
  title: o?.title ?? '', text: o?.text ?? '', vehicle: o?.vehicle ?? '',
  amount: o?.price ? String(o.price) : '',
  antes: deal ? `${deal.antes} €` : '', wasLabel: deal ? (o?.antes ? 'Antes' : 'Tarifa habitual') : '',
  pct: deal ? `-${deal.pct}%` : '', left: o ? offerLeft(o.until) : '', until: o ? untilLabel(o.until) : '',
};
const photos = {
  camper: await getImage({ src: getVehicle('camper').hero, width: 900, height: 560, format: 'webp' }),
  mileo: await getImage({ src: getVehicle('mileo').hero, width: 900, height: 560, format: 'webp' }),
};
---
<a class="oc" href="/ofertas-alquiler-autocaravana-sevilla/" data-vehicle={vid}>
  <span class="oc__media" aria-hidden="true">
    <img class="oc__photo" data-for="camper" src={photos.camper.src} width="900" height="560" alt="" loading="lazy" decoding="async" />
    <img class="oc__photo" data-for="mileo" src={photos.mileo.src} width="900" height="560" alt="" loading="lazy" decoding="async" />
    <span class="oc__tag">Oferta<span class="oc__tagveh" data-f="vehicle" hidden={!v.vehicle}>{v.vehicle}</span></span>
    <span class="oc__stamp"><b data-f="pct" hidden={!v.pct}>{v.pct}</b></span>
  </span>
  <span class="oc__body">
    <strong class="oc__title" data-f="title">{v.title}</strong>
    <span class="oc__text" data-f="text" hidden={!v.text}>{v.text}</span>
    <span class="oc__deal">
      <span class="oc__was"><span data-f="wasLabel" hidden={!v.wasLabel}>{v.wasLabel}</span> <s data-f="antes" hidden={!v.antes}>{v.antes}</s></span>
      <span class="oc__now">desde <b data-f="amount" hidden={!v.amount}>{v.amount}</b><span class="oc__eur">€</span><small>/día</small></span>
    </span>
    <span class="oc__foot">
      <span class="oc__left" data-f="left" hidden={!v.left}>{v.left}</span>
      <span class="oc__until" data-f="until" hidden={!v.until}>{v.until}</span>
      <span class="oc__cta">Reservar oferta <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
    </span>
  </span>
</a>

<style>
  .oc { --sale: #D4202C; position: relative; display: flex; flex-direction: column; background: #fff; border-radius: 18px; overflow: hidden; color: var(--ink); text-decoration: none; box-shadow: 0 24px 50px -28px rgba(80,40,0,.55); transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s; }
  .oc:hover { color: var(--ink); transform: translateY(-4px) rotate(-.4deg); box-shadow: 0 32px 60px -28px rgba(80,40,0,.65); }
  .oc__media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--sand-2); }
  .oc__photo { display: none; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .oc:not([data-vehicle="mileo"]) .oc__photo[data-for="camper"], .oc[data-vehicle="mileo"] .oc__photo[data-for="mileo"] { display: block; }
  .oc:hover .oc__photo { transform: scale(1.05); }
  .oc__tag { position: absolute; top: 1rem; left: 1rem; display: inline-flex; align-items: center; gap: .5rem; background: var(--ink); color: #fff; font-weight: 800; font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; padding: .45rem .8rem; border-radius: 8px; }
  .oc__tagveh { font-weight: 600; letter-spacing: .04em; opacity: .85; padding-left: .5rem; border-left: 1px solid rgba(255,255,255,.35); }
  .oc__stamp { position: absolute; top: .8rem; right: .9rem; width: 104px; height: 104px; border-radius: 50%; background: var(--sale); color: #fff; display: grid; place-items: center; transform: rotate(-12deg); box-shadow: 0 0 0 5px rgba(255,255,255,.9), 0 14px 26px -10px rgba(0,0,0,.5); transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .oc:hover .oc__stamp { transform: rotate(0) scale(1.06); }
  .oc__stamp b { font-family: var(--display); font-weight: 800; font-size: 2.1rem; letter-spacing: -.04em; }
  .oc__stamp:has([data-f=pct][hidden]) { display: none; }
  .oc__body { display: flex; flex-direction: column; gap: .5rem; padding: 1.3rem 1.4rem 1.4rem; flex: 1; }
  .oc__title { font-family: var(--display); font-weight: 800; font-size: clamp(1.35rem, 2.2vw, 1.65rem); line-height: 1.1; letter-spacing: -.01em; }
  .oc__text { font-size: .95rem; color: var(--muted); }
  .oc__deal { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .2rem 1rem; margin-top: .4rem; padding-top: .9rem; border-top: 2px dashed var(--line); }
  .oc__was { font-size: .9rem; color: var(--muted); }
  .oc__was s { font-weight: 700; text-decoration-thickness: 2px; text-decoration-color: var(--sale); }
  .oc__was:has([data-f=antes][hidden]) { display: none; }
  .oc__now { display: inline-flex; align-items: baseline; gap: .2rem; font-size: .95rem; font-weight: 600; color: var(--ink); }
  .oc__now b { font-family: var(--display); font-weight: 800; font-size: clamp(2.8rem, 5vw, 3.6rem); line-height: .9; color: var(--sale); letter-spacing: -.04em; margin-left: .25rem; }
  .oc__eur { font-family: var(--display); font-weight: 800; font-size: 1.8rem; color: var(--sale); }
  .oc__now small { font-size: .9rem; color: var(--muted); font-weight: 500; }
  .oc__now:has([data-f=amount][hidden]) { display: none; }
  .oc__foot { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin-top: auto; padding-top: .9rem; }
  .oc__left { display: inline-flex; align-items: center; gap: .35rem; background: #FDE7E8; color: #A3141E; font-weight: 800; font-size: .82rem; padding: .35rem .7rem; border-radius: 999px; }
  .oc__left::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--sale); animation: oc-pulse 1.6s ease-in-out infinite; }
  @keyframes oc-pulse { 50% { opacity: .25; } }
  .oc__until { font-size: .85rem; font-weight: 600; color: var(--muted); }
  .oc__cta { margin-left: auto; display: inline-flex; align-items: center; gap: .4rem; background: var(--forest); color: #fff; font-weight: 700; font-size: .95rem; padding: .7rem 1.1rem; border-radius: var(--radius-sm); }
  .oc__cta svg { width: 16px; height: 16px; transition: transform .2s; }
  .oc:hover .oc__cta svg { transform: translateX(3px); }
  [hidden] { display: none !important; }
  @media (max-width: 560px) {
    .oc__stamp { width: 84px; height: 84px; }
    .oc__stamp b { font-size: 1.7rem; }
    .oc__body { padding: 1.1rem 1.1rem 1.2rem; }
    .oc__cta { margin-left: 0; width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .oc__left::before { animation: none; } }
</style>
