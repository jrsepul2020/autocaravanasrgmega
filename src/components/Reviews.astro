---
import Icon from './Icon.astro';
import { site } from '../data/site';
// Opiniones reales de clientes (de la web anterior). Añade aquí nuevas reseñas de Google.
const reviews = [
  { name: 'Juan Antonio', model: 'Mileo 268', text: 'Nuestra primera experiencia en autocaravana y todo fue facilísimo. Nos lo explicaron todo con paciencia, la recogimos un domingo sin problema y recorrimos Andalucía encantados.' },
  { name: 'Pedro', model: 'Camper 120 UP', text: 'Fin de semana largo perfecto. Con la placa solar no nos hizo falta enchufe, viajamos con nuestro perro sin coste extra y saber que había asistencia 24 h nos dio mucha tranquilidad.' },
  { name: 'Francisco Montes', model: 'Mileo 268', text: 'Dejamos el coche en su parking gratis y nos recomendaron apps para pernoctar. Hicimos la ruta por la costa de Cádiz y repetiremos seguro.' },
  { name: 'Rosa', model: 'Mileo 268', text: 'Atención de diez desde el primer mensaje: nos ayudaron a elegir el vehículo para nuestra ruta por Cádiz. La autocaravana estaba impecable y muy limpia.' },
];
---
<div class="rv">
  <div class="rv__grid">
    {reviews.map((r) => (
      <figure class="rv__card">
        <div class="rv__stars" aria-label="5 de 5 estrellas">{[1,2,3,4,5].map(() => <Icon name="star" />)}</div>
        <blockquote>“{r.text}”</blockquote>
        <figcaption><span class="rv__av" aria-hidden="true">{r.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}</span><span><strong>{r.name}</strong><small>Alquiló la {r.model}</small></span></figcaption>
      </figure>
    ))}
  </div>
  <div class="rv__gbp">
    <Icon name="google" class="rv__g" />
    <p><strong>¿Ya viajaste con nosotros?</strong> Tu opinión en Google ayuda a otros viajeros a decidirse.</p>
    <a class="btn btn--ghost btn--sm" href={site.gbpReviewUrl} target="_blank" rel="noopener">Dejar reseña en Google</a>
  </div>
</div>
<style>
  .rv__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .rv__card { margin: 0; background: #fff; border-radius: var(--radius); padding: 1.3rem 1.3rem 1.2rem; box-shadow: 0 0 0 1px rgba(31,74,56,.08), 0 10px 24px -16px rgba(31,74,56,.35); display: flex; flex-direction: column; gap: .75rem; }
  .rv__stars { display: flex; gap: 2px; color: var(--terra); }
  .rv__stars :global(svg) { width: 16px; height: 16px; }
  blockquote { margin: 0; font-size: .95rem; line-height: 1.55; color: #33403b; flex: 1; }
  figcaption { display: flex; align-items: center; gap: .65rem; font-size: .88rem; }
  figcaption > span:last-child { display: grid; line-height: 1.3; }
  figcaption strong { color: var(--ink); }
  figcaption small { color: var(--muted); font-size: .8rem; }
  .rv__av { width: 38px; height: 38px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--sand-2); color: var(--forest); font-family: var(--display); font-weight: 700; font-size: .9rem; }
  .rv__card:nth-child(2) .rv__av { background: var(--forest); color: #fff; }
  .rv__card:nth-child(3) .rv__av { background: var(--terra); color: #fff; }
  .rv__gbp { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1rem; padding: 1rem 1.3rem; background: #fff; border-radius: var(--radius); box-shadow: 0 0 0 1px rgba(31,74,56,.08); }
  .rv__gbp p { margin: 0; flex: 1; min-width: 220px; }
  :global(.rv__g) { width: 28px; height: 28px; }
</style>
