---
/**
 * CARRUSEL DE FOTOS
 * Sube las fotos a:  src/assets/carrusel/
 *  - Formatos: .jpg, .jpeg, .png o .webp (la web las convierte y comprime sola).
 *  - Se ordenan por nombre: empieza el nombre con 01-, 02-, 03-…
 *  - El nombre del archivo se usa como texto alternativo (SEO): usa palabras descriptivas,
 *    p. ej. "12-mileo-268-aparcada-en-playa-de-bolonia.jpg".
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { title?: string; eyebrow?: string; lead?: string }
const {
  title = 'Así son nuestras autocaravanas',
  eyebrow = 'Galería',
  lead = 'Fotos reales de la Benimar Mileo 268 y la Camper 120 UP, por dentro y por fuera.',
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/carrusel/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const toAlt = (path: string) => {
  const name = path.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/^\d+[-_ ]*/, '').replace(/[-_]+/g, ' ').trim();
  return name.charAt(0).toUpperCase() + name.slice(1);
};
const photos = await Promise.all(
  Object.keys(files).sort().map(async (p) => ({
    src: files[p].default,
    alt: toAlt(p),
    full: (await getImage({ src: files[p].default, width: 1600, format: 'webp' })).src,
  })),
);
---
{photos.length > 0 && (
  <section class="section pc" aria-labelledby="pc-title">
    <div class="container pc__head">
      <div>
        <span class="eyebrow">{eyebrow}</span>
        <h2 id="pc-title">{title}</h2>
        <p class="lead">{lead}</p>
      </div>
      <div class="pc__ctrl">
        <button type="button" class="pc__btn" data-dir="-1" aria-label="Foto anterior">‹</button>
        <button type="button" class="pc__btn" data-dir="1" aria-label="Foto siguiente">›</button>
      </div>
    </div>
    <div class="pc__track" tabindex="0" aria-label="Carrusel de fotos">
      {photos.map((p, i) => (
        <figure class="pc__slide">
          <button type="button" class="pc__open" data-full={p.full} data-alt={p.alt} aria-label={`Ampliar: ${p.alt}`}>
            <Image src={p.src} alt={p.alt} widths={[420, 720, 1000]} sizes="(max-width: 760px) 85vw, 520px" loading={i < 2 ? 'eager' : 'lazy'} />
          </button>
          <figcaption>{p.alt}</figcaption>
        </figure>
      ))}
    </div>
    <div class="container pc__bar"><span class="pc__progress"></span></div>
    <dialog class="pc__lb" aria-label="Foto ampliada">
      <button type="button" class="pc__x" aria-label="Cerrar">×</button>
      <button type="button" class="pc__nav pc__prev" aria-label="Anterior">‹</button>
      <img alt="" />
      <button type="button" class="pc__nav pc__next" aria-label="Siguiente">›</button>
      <p></p>
    </dialog>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.pc').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.pc__track')!;
    const bar = root.querySelector<HTMLElement>('.pc__progress')!;
    const slides = [...root.querySelectorAll<HTMLButtonElement>('.pc__open')];
    const step = () => (track.querySelector<HTMLElement>('.pc__slide')?.offsetWidth ?? 400) + 16;
    const scrollBy = (d: number) => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      if (d > 0 && atEnd) track.scrollTo({ left: 0, behavior: 'smooth' });
      else track.scrollBy({ left: d * step(), behavior: 'smooth' });
    };
    root.querySelectorAll<HTMLButtonElement>('.pc__btn').forEach((b) => b.addEventListener('click', () => scrollBy(Number(b.dataset.dir))));
    const updateBar = () => {
      const max = track.scrollWidth - track.clientWidth;
      bar.style.width = `${Math.max(8, ((track.scrollLeft + track.clientWidth) / track.scrollWidth) * 100)}%`;
      if (max <= 0) bar.style.width = '100%';
    };
    track.addEventListener('scroll', updateBar, { passive: true });
    updateBar();

    // Avance automático suave (se pausa al interactuar o si el usuario prefiere menos movimiento)
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    const start = () => { if (!reduce) timer = window.setInterval(() => scrollBy(1), 5000); };
    const stop = () => window.clearInterval(timer);
    ['pointerenter', 'focusin', 'touchstart'].forEach((e) => track.addEventListener(e, stop, { passive: true }));
    track.addEventListener('pointerleave', () => { stop(); start(); });
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(track);

    // Lightbox
    const dlg = root.querySelector<HTMLDialogElement>('.pc__lb')!;
    const img = dlg.querySelector('img')!; const cap = dlg.querySelector('p')!;
    let idx = 0;
    const show = (i: number) => { idx = (i + slides.length) % slides.length; img.src = slides[idx].dataset.full!; img.alt = slides[idx].dataset.alt!; cap.textContent = slides[idx].dataset.alt!; };
    slides.forEach((s, i) => s.addEventListener('click', () => { stop(); show(i); dlg.showModal(); }));
    dlg.querySelector('.pc__x')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.pc__prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.pc__next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(idx - 1); if (e.key === 'ArrowRight') show(idx + 1); });
  });
</script>

<style>
  .pc { overflow: hidden; }
  .pc__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.8rem; }
  .pc__head .lead { margin: 0; }
  .pc__ctrl { display: flex; gap: .6rem; }
  .pc__btn { width: 52px; height: 52px; border-radius: 50%; border: 2px solid var(--pine); background: #fff; color: var(--pine); font-size: 1.7rem; line-height: 1; cursor: pointer; transition: .2s; }
  .pc__btn:hover { background: var(--pine); color: #fff; }
  .pc__track {
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding: 0 max(16px, calc((100vw - var(--max)) / 2)); scroll-padding: 0 max(16px, calc((100vw - var(--max)) / 2));
    scrollbar-width: none;
  }
  .pc__track::-webkit-scrollbar { display: none; }
  .pc__slide { flex: 0 0 min(85vw, 520px); margin: 0; scroll-snap-align: start; }
  .pc__open { display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; border-radius: var(--radius); overflow: hidden; aspect-ratio: 3/2; background: var(--sand); }
  .pc__open img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .pc__open:hover img { transform: scale(1.04); }
  .pc__slide figcaption { font-size: .88rem; color: var(--muted); margin-top: .55rem; }
  .pc__bar { height: 4px; background: var(--pine-3); border-radius: 4px; margin-top: 1.4rem; overflow: hidden; }
  .pc__progress { display: block; height: 100%; width: 10%; background: var(--terra); border-radius: 4px; transition: width .3s ease; }
  .pc__lb { border: 0; padding: 0; background: transparent; width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; }
  .pc__lb::backdrop { background: rgba(20, 32, 26, .94); }
  .pc__lb[open] { display: grid; place-items: center; }
  .pc__lb img { max-width: 92vw; max-height: 82vh; object-fit: contain; border-radius: 10px; }
  .pc__lb p { position: absolute; bottom: 3vh; left: 0; right: 0; text-align: center; color: #fff; margin: 0; }
  .pc__x, .pc__nav { position: absolute; background: rgba(255,255,255,.14); color: #fff; border: 0; width: 52px; height: 52px; border-radius: 50%; font-size: 2rem; line-height: 1; cursor: pointer; }
  .pc__x { top: 20px; right: 20px; }
  .pc__prev { left: 16px; top: 50%; } .pc__next { right: 16px; top: 50%; }
  @media (max-width: 760px) { .pc__ctrl { display: none; } }
</style>
