---
/** Ubicación + Google Business Profile. Mapa esquemático propio (ligero y sin cookies); el mapa de Google solo se carga si el usuario lo pide. */
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';
interface Props { title?: string }
const { title = 'Recogida y entrega en Sevilla (Salteras)' } = Astro.props;
---
<section class="section section--sand" aria-labelledby="loc-title">
  <div class="container loc">
    <div>
      <h2 id="loc-title">{title}</h2>
      <p class="loc__where"><Icon name="shield" /><span>En el <strong>Polígono Los Llanos</strong>, al lado de <strong>Santiponce</strong> y muy cerca de <strong>Itálica</strong>. Un polígono <strong>cerrado y protegido</strong>.</span></p>
      <p class="lead">Recoges y devuelves la autocaravana en nuestras instalaciones, a {site.distanceToSevilla} por la A-66 y muy cerca de Bormujos, Camas, Santiponce y todo el Aljarafe. Tu coche se queda gratis en nuestro parking cerrado.</p>
      <ul class="loc__list">
        <li><Icon name="pin" /><span>{site.address.street}<br />{site.address.postalCode} {site.address.city} (Sevilla)</span></li>
        <li><Icon name="clock" /><span>{site.hours}<br /><small>Fuera de horario, fines de semana o festivos: pacta con nosotros la entrega y la devolución</small></span></li>
        <li><Icon name="parking" /><span>Parking cerrado y cubierto gratuito para tu coche</span></li>
      </ul>
      <div class="btn-row">
        <a class="btn btn--primary" href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="route" /> Cómo llegar</a>
        <a class="btn btn--wa" href={waLink('Hola, quiero quedar para recoger la autocaravana')} target="_blank" rel="noopener"><Icon name="whatsapp" /> Escríbenos</a>
      </div>
    </div>
    <figure class="loc__map">
      <div class="loc__canvas" data-src={site.mapEmbed}>
        <svg viewBox="0 0 560 440" role="img" aria-labelledby="loc-map-t">
          <title id="loc-map-t">Mapa esquemático: RG MEGA Autocaravanas en el Polígono Los Llanos (Salteras), junto a Santiponce e Itálica, a 15 minutos del centro de Sevilla por la A-66</title>
          <defs>
            <pattern id="loc-grid" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" fill="none" stroke="#E2E8E3" stroke-width="1" /></pattern>
          </defs>
          <rect width="560" height="440" fill="#F1F4F1" />
          <rect width="560" height="440" fill="url(#loc-grid)" />
          <!-- zonas urbanas -->
          <ellipse cx="452" cy="352" rx="96" ry="70" fill="#E3E9E4" />
          <ellipse cx="300" cy="306" rx="34" ry="24" fill="#E3E9E4" />
          <ellipse cx="270" cy="178" rx="30" ry="20" fill="#E3E9E4" />
          <ellipse cx="72" cy="236" rx="32" ry="22" fill="#E3E9E4" />
          <ellipse cx="232" cy="92" rx="42" ry="22" fill="#DCE6DF" />
          <!-- río Guadalquivir -->
          <path d="M560 70 C 470 110, 420 160, 392 230 S 372 340, 360 440" fill="none" stroke="#C9DFE6" stroke-width="18" stroke-linecap="round" />
          <text x="402" y="196" class="loc__river" transform="rotate(62 402 196)">Guadalquivir</text>
          <!-- carreteras -->
          <path d="M0 236 C 120 236, 200 250, 300 306 S 400 350, 452 352" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" />
          <path d="M452 352 C 400 330, 340 320, 300 300 C 285 260, 280 215, 268 178 C 255 140, 240 110, 228 60 L 214 0" fill="none" stroke="#fff" stroke-width="11" stroke-linecap="round" />
          <!-- ruta destacada Sevilla → RG MEGA -->
          <path d="M452 352 C 400 330, 340 320, 300 300 C 285 260, 280 215, 268 178 C 255 140, 244 116, 236 98" fill="none" stroke="#1F4A38" stroke-width="4" stroke-dasharray="2 9" stroke-linecap="round" />
          <g class="loc__road"><rect x="282" y="226" width="44" height="22" rx="5" /><text x="304" y="241">A-66</text></g>
          <!-- poblaciones -->
          <g class="loc__place"><circle cx="452" cy="352" r="9" /><text x="452" y="384" class="loc__city">Sevilla</text><text x="452" y="402" class="loc__small">centro</text></g>
          <g class="loc__place"><circle cx="300" cy="306" r="5" /><text x="262" y="336">Camas</text></g>
          <g class="loc__place"><circle cx="270" cy="178" r="5" /><text x="282" y="183" class="s">Santiponce</text></g>
          <g class="loc__place loc__place--sight"><circle cx="292" cy="146" r="5" /><text x="302" y="151" class="s">Itálica</text></g>
          <g class="loc__place"><circle cx="72" cy="236" r="5" /><text x="72" y="266">Salteras</text></g>
          <!-- tiempo -->
          <g class="loc__time"><rect x="330" y="262" width="96" height="30" rx="15" /><text x="378" y="282">≈ 15 min</text></g>
          <!-- RG MEGA -->
          <g class="loc__pin" transform="translate(236 98)">
            <path d="M0 0 C -6 -14, -20 -22, -20 -36 A 20 20 0 1 1 20 -36 C 20 -22, 6 -14, 0 0 Z" />
            <circle cx="0" cy="-36" r="7" fill="#fff" />
          </g>
          <g class="loc__label"><rect x="96" y="30" width="118" height="44" rx="10" /><text x="155" y="49" class="loc__lt">RG MEGA</text><text x="155" y="65" class="loc__ls">Pol. Los Llanos</text></g>
        </svg>
      </div>
      <figcaption class="loc__bar">
        <span><strong>{site.address.street}</strong> · {site.address.postalCode} {site.address.city}</span>
        <span class="loc__actions">
          <a href={site.mapsUrl} target="_blank" rel="noopener">Abrir en Google Maps <Icon name="arrow" /></a>
          <button type="button" class="loc__load">Ver mapa interactivo</button>
        </span>
      </figcaption>
    </figure>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.loc__load').forEach((b) => b.addEventListener('click', () => {
    const canvas = b.closest('.loc__map')?.querySelector<HTMLElement>('.loc__canvas');
    if (!canvas) return;
    canvas.innerHTML = `<iframe src="${canvas.dataset.src}" title="Mapa de RG MEGA Autocaravanas en Salteras, Sevilla" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
    b.remove();
  }));
</script>
<style>
  .loc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .loc__where { display: flex; gap: .6rem; align-items: flex-start; margin: -.2rem 0 1.2rem; padding: .1rem 0 .1rem 1rem; border-left: 3px solid var(--terra); font-size: 1.02rem; color: var(--ink); max-width: 56ch; }
  .loc__where :global(svg) { width: 22px; height: 22px; color: var(--forest); flex: none; margin-top: .1rem; }
  .loc__where strong { color: var(--forest); }
  .loc__list { list-style: none; padding: 0; margin: 0 0 1.6rem; display: grid; gap: .8rem; }
  .loc__list li { display: flex; gap: .7rem; }
  .loc__list :global(svg) { width: 22px; height: 22px; color: var(--forest); flex: none; margin-top: .15rem; }
  .loc__map { margin: 0; background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 0 0 1px var(--line), 0 30px 60px -30px rgba(27,36,32,.35); }
  .loc__canvas { aspect-ratio: 560 / 440; }
  .loc__canvas svg { display: block; width: 100%; height: 100%; }
  .loc__canvas :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .loc__river { font: italic 500 13px var(--font); fill: #7FA8B5; letter-spacing: .08em; }
  .loc__road rect { fill: #1B2420; }
  .loc__road text { font: 700 12px var(--font); fill: #fff; text-anchor: middle; }
  .loc__place circle { fill: #fff; stroke: #56625D; stroke-width: 2.5; }
  .loc__place text { font: 600 14px var(--font); fill: #3F4A45; text-anchor: middle; }
  .loc__place text.s { text-anchor: start; }
  .loc__place .loc__city { font: 700 20px var(--display); fill: #1B2420; }
  .loc__place .loc__small { font: 500 12px var(--font); fill: #56625D; }
  .loc__place--sight circle { stroke: #A07A2C; }
  .loc__time rect { fill: #fff; stroke: #1F4A38; stroke-width: 2; }
  .loc__time text { font: 700 14px var(--font); fill: #1F4A38; text-anchor: middle; }
  .loc__pin path { fill: #1F4A38; filter: drop-shadow(0 6px 6px rgba(0,0,0,.25)); }
  .loc__label rect { fill: #1F4A38; }
  .loc__label text { fill: #fff; text-anchor: middle; }
  .loc__lt { font: 700 15px var(--display); }
  .loc__ls { font: 500 11px var(--font); opacity: .85; }
  .loc__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .6rem 1.2rem; padding: .9rem 1.2rem; border-top: 1px solid var(--line); font-size: .92rem; color: var(--muted); }
  .loc__bar strong { color: var(--ink); }
  .loc__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.1rem; }
  .loc__actions a { display: inline-flex; align-items: center; gap: .3rem; font-weight: 700; color: var(--forest); text-decoration: none; }
  .loc__actions a:hover { text-decoration: underline; }
  .loc__actions :global(svg) { width: 15px; height: 15px; }
  .loc__load { border: 0; background: none; padding: 0; font: inherit; font-weight: 600; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .loc__load:hover { color: var(--forest); }
  @media (max-width: 860px) { .loc { grid-template-columns: minmax(0, 1fr); } }
</style>
