---
/** Ubicación + Google Business Profile. El mapa se carga al hacer clic (más rápido y sin cookies hasta interacción). */
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';
interface Props { title?: string }
const { title = 'Recogida y entrega en Sevilla (Salteras)' } = Astro.props;
---
<section class="section section--sand" aria-labelledby="loc-title">
  <div class="container loc">
    <div>
      <h2 id="loc-title">{title}</h2>
      <p class="lead">Recoges y devuelves la autocaravana en nuestras instalaciones, a {site.distanceToSevilla} por la A-66 y muy cerca de Bormujos, Camas, Santiponce y todo el Aljarafe. Tu coche se queda gratis en nuestro parking cerrado.</p>
      <ul class="loc__list">
        <li><Icon name="pin" /><span>{site.address.street}<br />{site.address.postalCode} {site.address.city} (Sevilla)</span></li>
        <li><Icon name="clock" /><span>{site.hours}<br /><small>Fuera de horario, fines de semana o festivos: pacta con nosotros la entrega y la devolución</small></span></li>
        <li><Icon name="parking" /><span>Parking cerrado y cubierto gratuito para tu coche</span></li>
      </ul>
      <div class="btn-row">
        <a class="btn btn--dark" href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="route" /> Cómo llegar</a>
        <a class="btn btn--wa" href={waLink('Hola, quiero quedar para recoger la autocaravana')} target="_blank" rel="noopener"><Icon name="whatsapp" /> Escríbenos</a>
      </div>
    </div>
    <div class="loc__map">
      <button type="button" class="loc__load" data-src={site.mapEmbed}>
        <Icon name="pin" />
        <span><strong>Ver mapa de Google</strong><small>RG MEGA Autocaravanas · Salteras, Sevilla</small></span>
      </button>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.loc__load').forEach((b) => b.addEventListener('click', () => {
    b.outerHTML = `<iframe src="${b.dataset.src}" title="Mapa de RG MEGA Autocaravanas en Salteras, Sevilla" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
  }));
</script>
<style>
  .loc { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .loc__list { list-style: none; padding: 0; margin: 0 0 1.6rem; display: grid; gap: .8rem; }
  .loc__list li { display: flex; gap: .7rem; }
  .loc__list :global(svg) { width: 22px; height: 22px; color: var(--terra-ink); flex: none; margin-top: .15rem; }
  .loc__map { aspect-ratio: 4/3; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: var(--on-dark); }
  .loc__map :global(iframe) { width: 100%; height: 100%; border: 0; }
  .loc__load { width: 100%; height: 100%; border: 0; cursor: pointer; display: grid; place-content: center; justify-items: center; gap: .6rem; font: inherit; color: var(--pine);
    background: radial-gradient(circle at 50% 45%, #fff 0 12%, transparent 13%), repeating-linear-gradient(45deg, var(--on-dark) 0 18px, var(--on-dark) 18px 36px); }
  .loc__load :global(svg) { width: 44px; height: 44px; color: var(--terra-ink); }
  .loc__load span { display: grid; text-align: center; }
  .loc__load small { color: var(--muted); }
  @media (max-width: 860px) { .loc { grid-template-columns: 1fr; gap: 2rem; } }
</style>
