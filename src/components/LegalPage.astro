---
import Base from '../layouts/Base.astro';
interface Props { title: string; h1: string; url: string }
const { title, h1, url } = Astro.props;
---
<Base title={`${title} | RG MEGA Autocaravanas`} description={`${h1} de RG MEGA Autocaravanas, alquiler de autocaravanas en Sevilla.`} breadcrumbs={[{ name: h1, url }]}>
  <section class="section" style="padding-top:2rem">
    <div class="narrow prose"><h1>{h1}</h1><slot /></div>
  </section>
</Base>
