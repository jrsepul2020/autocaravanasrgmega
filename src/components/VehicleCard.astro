---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import PriceNote from './PriceNote.astro';
import { type Vehicle, fromPrice } from '../data/vehicles';
interface Props { vehicle: Vehicle; headingLevel?: 'h2' | 'h3' }
const { vehicle: v, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="vc">
  <a href={v.slug} class="vc__img" tabindex="-1" aria-hidden="true">
    <Image src={v.hero} alt={v.gallery[0].alt} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 580px" />
    <span class="vc__badge">{v.type}</span>
  </a>
  <div class="vc__body">
    <H class="vc__name"><a href={v.slug}>Alquiler {v.name}</a></H>
    <p class="vc__tag">{v.tagline}</p>
    <ul class="vc__facts">
      {v.keyFacts.slice(0, 4).map((f) => <li><small>{f.label}</small><strong>{f.value}</strong></li>)}
    </ul>
    <p class="vc__ideal"><Icon name="users" /> Ideal para: {v.idealFor}</p>
    <div class="vc__foot">
      <div class="vc__pricebox">
        <p class="vc__price"><small>desde</small> <strong><span data-from={v.id}>{fromPrice(v)}</span> €<span class="vc__unit">/día</span></strong></p>
        <PriceNote compact />
      </div>
      <div class="btn-row">
        <a class="btn btn--ghost btn--sm" href={v.slug}>Ver ficha</a>
        <a class="btn btn--primary btn--sm" href={`/contacto/?modelo=${v.id}#presupuesto`}>Consultar fechas</a>
      </div>
    </div>
  </div>
</article>
<style>
  .vc { background: #fff; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .vc__img { position: relative; display: block; aspect-ratio: 16/10; overflow: hidden; }
  .vc__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .vc:hover .vc__img img { transform: scale(1.04); }
  .vc__badge { position: absolute; top: 14px; left: 14px; background: rgba(255,255,255,.95); color: var(--pine); padding: .3rem .75rem; border-radius: 999px; font-size: .8rem; font-weight: 650; }
  .vc__body { padding: 1.5rem; display: flex; flex-direction: column; gap: .9rem; flex: 1; }
  .vc__name { margin: 0; font-size: 1.5rem; }
  .vc__name a { color: inherit; text-decoration: none; }
  .vc__tag { margin: 0; color: var(--muted); }
  .vc__facts { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; }
  .vc__facts li { background: var(--sand); border-radius: 10px; padding: .5rem .6rem; display: grid; }
  .vc__facts small { font-size: .7rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .vc__facts strong { font-size: .9rem; color: var(--pine); }
  .vc__ideal { margin: 0; font-size: .92rem; display: flex; gap: .45rem; align-items: flex-start; }
  .vc__ideal :global(svg) { width: 18px; height: 18px; flex: none; margin-top: .2rem; color: var(--terra-ink); }
  .vc__foot { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .vc__price { margin: 0; color: var(--muted); }
  .vc__pricebox { max-width: 260px; }
  .vc__pricebox :global(.pn) { margin-top: .15rem; }
  .vc__unit { font-size: .55em; font-weight: 500; margin-left: .1em; }
  .vc__price strong { font-family: var(--display); font-size: 2rem; color: var(--red); }
  @media (max-width: 480px) { .vc__facts { grid-template-columns: repeat(2, 1fr); } }
</style>
