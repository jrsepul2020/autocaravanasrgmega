---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import PriceNote from './PriceNote.astro';
import { type Vehicle, fromPrice } from '../data/vehicles';
interface Props { vehicle: Vehicle; headingLevel?: 'h2' | 'h3' }
const { vehicle: v, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const kf = (re: RegExp) => v.keyFacts.find((f) => re.test(f.label))?.value;
const facts = [
  { icon: 'users', text: `${kf(/viaje/i) ?? '4'} plazas` },
  { icon: 'bed', text: `${kf(/dormir/i) ?? '4'} para dormir` },
  { icon: 'key', text: 'Carnet B' },
];
---
<article class="vc">
  <a href={v.slug} class="vc__img" tabindex="-1" aria-hidden="true">
    <Image src={v.hero} alt={v.gallery[0].alt} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 580px" />
  </a>
  <div class="vc__body">
    <p class="vc__type">{v.type}</p>
    <H class="vc__name"><a href={v.slug}>{v.name}</a></H>
    <p class="vc__tag">{v.tagline}</p>
    <ul class="vc__facts">
      {facts.map((f) => <li><Icon name={f.icon} /><span>{f.text}</span></li>)}
    </ul>
    <div class="vc__foot">
      <div class="vc__pricebox">
        <p class="vc__price">Desde <span data-from={v.id}>{fromPrice(v)}</span> €/día</p>
        <PriceNote compact />
      </div>
      <a class="btn btn--primary btn--sm" href={v.slug}>Ver vehículo <Icon name="arrow" class="i-arrow" /></a>
    </div>
    <a class="vc__dates" href={`/contacto/?modelo=${v.id}#presupuesto`}><Icon name="calendar" /> Consultar fechas de la {v.short}</a>
  </div>
</article>
<style>
  .vc { background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; transition: box-shadow .3s, transform .3s cubic-bezier(.2,.8,.2,1); }
  .vc:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .vc__img { display: block; aspect-ratio: 16/9; overflow: hidden; background: var(--sand-2); }
  .vc__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.8,.2,1); }
  .vc:hover .vc__img :global(img) { transform: scale(1.04); }
  .vc__body { padding: 1.4rem 1.5rem 1.3rem; display: flex; flex-direction: column; gap: .55rem; flex: 1; }
  .vc__type { justify-self: start; align-self: flex-start; margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--forest); background: var(--terra); padding: .3rem .7rem; border-radius: 999px; }
  .vc__name { margin: 0; font-size: 1.55rem; color: var(--ink); }
  .vc__name a { color: inherit; text-decoration: none; }
  .vc__tag { margin: 0; color: var(--muted); font-size: .97rem; max-width: 46ch; }
  .vc__facts { list-style: none; padding: 0; margin: .3rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; font-size: .9rem; color: var(--muted); }
  .vc__facts li { display: inline-flex; align-items: center; gap: .4rem; }
  .vc__facts :global(svg) { width: 18px; height: 18px; color: var(--terra-2); flex: none; }
  .vc__facts span { color: var(--ink); font-weight: 500; }
  .vc__foot { margin-top: auto; padding-top: 1rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: .9rem; }
  .vc__price { margin: 0; font-family: var(--display); font-weight: 700; font-size: 1.45rem; color: var(--price); line-height: 1.1; }
  .vc__pricebox { max-width: 270px; }
  .vc__pricebox :global(.pn) { margin-top: .25rem; }
  .vc__dates { display: inline-flex; align-items: center; gap: .4rem; margin-top: .4rem; font-size: .88rem; font-weight: 600; color: var(--forest); text-decoration: none; }
  .vc__dates:hover { text-decoration: underline; color: var(--forest); }
  .vc__dates :global(svg) { width: 16px; height: 16px; }
</style>
