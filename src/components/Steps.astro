---
const steps = [
  { t: 'Elige fechas', d: 'Mira el calendario de disponibilidad y elige Mileo 268 o Camper 120 UP.' },
  { t: 'Escríbenos', d: 'Por WhatsApp, teléfono o formulario. Te damos precio cerrado en menos de 24 h.' },
  { t: 'Reserva', d: 'Confirmas con el 50 % (o el 100 % si faltan menos de 30 días).' },
  { t: 'Recoge y disfruta', d: 'Te lo explicamos todo en Salteras, dejas tu coche en nuestro parking y ¡a la carretera!' },
];
---
<ol class="st">
  {steps.map((s, i) => (
    <li><span class="st__n">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
  ))}
</ol>
<style>
  .st { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 1.5rem; counter-reset: s; }
  .st li { position: relative; background: #fff; border-radius: var(--radius); padding: 1.6rem 1.4rem; border: 1px solid var(--line); }
  .st__n { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--terra); color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,.22); font-family: var(--display); font-weight: 750; font-size: 1.2rem; margin-bottom: 1rem; }
  .st h3 { margin: 0 0 .3rem; font-size: 1.2rem; }
  .st p { margin: 0; color: var(--muted); font-size: .95rem; }
</style>
