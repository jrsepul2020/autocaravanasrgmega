---
import Icon from './Icon.astro';
const steps = [
  { icon: 'calendar', t: 'Elige fechas', d: 'Mira el calendario de disponibilidad y elige Mileo 268 o Camper 120 UP.' },
  { icon: 'whatsapp', t: 'Escríbenos', d: 'Por WhatsApp, teléfono o formulario. Te damos precio cerrado en menos de 24 h.' },
  { icon: 'check', t: 'Reserva', d: 'Confirmas con el 50 % (o el 100 % si faltan menos de 30 días).' },
  { icon: 'key', t: 'Recoge y disfruta', d: 'Te lo explicamos todo en Salteras, dejas tu coche en nuestro parking y ¡a la carretera!' },
];
---
<ol class="st">
  {steps.map((s, i) => (
    <li><div class="st__top"><span class="st__n">{i + 1}</span><span class="st__i"><Icon name={s.icon} /></span></div><h3>{s.t}</h3><p>{s.d}</p></li>
  ))}
</ol>
<style>
  .st { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 2rem 2rem; }
  .st li { border-top: 2px solid var(--line); padding-top: 1.2rem; }
  .st__top { display: flex; align-items: center; gap: .8rem; margin-bottom: .9rem; }
  .st__n { font-family: var(--display); font-weight: 700; font-size: 2.6rem; line-height: .9; color: var(--forest); letter-spacing: -.03em; }
  .st__i { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--sand-2); color: var(--forest); }
  .st__i :global(svg) { width: 20px; height: 20px; }
  .st h3 { margin: 0 0 .35rem; font-size: 1.2rem; }
  .st p { margin: 0; color: var(--muted); font-size: .95rem; }
  /* Sobre banda oscura */
  :global(.section--pine) .st li { border-top-color: rgba(255,255,255,.2); }
  :global(.section--pine) .st__n, :global(.section--pine) .st h3 { color: #fff; }
  :global(.section--pine) .st p { color: var(--on-dark); }
  :global(.section--pine) .st__i { background: rgba(255,255,255,.12); color: #fff; }
</style>
