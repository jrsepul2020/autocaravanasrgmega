---
import type { Faq } from '../data/faqs';
import { px } from '../data/vehicles';
interface Props { items: Faq[]; schema?: boolean }
const { schema = true } = Astro.props;
const items = Astro.props.items.map((f) => ({ ...f, q: px(f.q), a: px(f.a) }));
const json = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<div class="faq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary><h3>{f.q}</h3></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
{schema && <script type="application/ld+json" set:html={JSON.stringify(json)} />}
<style>
  .faq { display: grid; gap: .7rem; }
  details { background: #fff; border-radius: var(--radius); padding: 0 1.2rem; box-shadow: 0 0 0 1px rgba(31,74,56,.08); transition: box-shadow .2s, background .2s; }
  details:hover { box-shadow: var(--shadow); }
  details[open] { box-shadow: var(--shadow); }
  summary { cursor: pointer; list-style: none; padding: 1.1rem 2.6rem 1.1rem 0; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--sand-2); color: var(--forest); font-size: 1.25rem; font-weight: 500; line-height: 1; transition: transform .25s cubic-bezier(.2,.8,.2,1), background .2s; }
  details[open] summary::after { background: var(--forest); color: #fff; }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  summary h3 { margin: 0; font-size: 1.05rem; font-family: var(--font); font-weight: 700; color: var(--pine); letter-spacing: 0; }
  details p { margin: 0 0 1.2rem; color: #3a4642; }
</style>
