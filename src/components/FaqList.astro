---
import type { Faq } from '../data/faqs';
import { px } from '../data/vehicles';
interface Props { items: Faq[]; schema?: boolean }
const { schema = true } = Astro.props;
const items = Astro.props.items.map((f) => ({ ...f, q: px(f.q), a: px(f.a) }));
const json = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<div class="faq">
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary><h3>{f.q}</h3></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
{schema && <script type="application/ld+json" set:html={JSON.stringify(json)} />}
<style>
  .faq { display: grid; border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 1.15rem 2.6rem 1.15rem 0; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; color: var(--forest); font-size: 1.5rem; font-weight: 400; line-height: 1; transition: transform .25s cubic-bezier(.2,.8,.2,1); }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  summary:hover h3 { color: var(--forest); }
  summary h3 { margin: 0; font-size: 1.05rem; font-family: var(--font); font-weight: 650; color: var(--ink); letter-spacing: 0; transition: color .15s; }
  details p { margin: 0 0 1.3rem; color: var(--muted); max-width: 68ch; }
</style>
