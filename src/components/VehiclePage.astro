---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import PriceNote from './PriceNote.astro';
import Gallery from './Gallery.astro';
import PriceTable from './PriceTable.astro';
import AvailabilityCalendar from './AvailabilityCalendar.astro';
import QuoteForm from './QuoteForm.astro';
import FaqList from './FaqList.astro';
import Location from './Location.astro';
import VehicleCard from './VehicleCard.astro';
import { site, waLink, pricing } from '../data/site';
import { vehicles, fromPrice, type Vehicle } from '../data/vehicles';
import type { Faq } from '../data/faqs';

interface Props { vehicle: Vehicle; title: string; description: string; h1: string; faqs: Faq[] }
const { vehicle: v, title, description, h1, faqs } = Astro.props;
const other = vehicles.find((x) => x.id !== v.id)!;
const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Alquiler ${v.name} en Sevilla`,
  brand: { '@type': 'Brand', name: 'Benimar' },
  category: v.type,
  image: new URL('/og-alquiler-autocaravanas-sevilla.jpg', site.url).href,
  description: v.tagline,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'EUR',
    lowPrice: fromPrice(v),
    highPrice: Math.max(...Object.values(v.prices).map((p) => p.short)),
    offerCount: 8,
    availability: 'https://schema.org/InStock',
    seller: { '@id': `${site.url}/#negocio` },
  },
};
---
<Base title={title} description={description} schema={[product]} breadcrumbs={[{ name: `Alquiler ${v.short}`, url: v.slug }]}>
  <section class="vp-hero container">
    <div class="vp-hero__head">
      <span class="eyebrow">{v.type} · Sevilla</span>
      <h1>{h1}</h1>
      <p class="lead">{v.tagline}. Ideal para {v.idealFor.toLowerCase()}.</p>
    </div>
    <Gallery images={v.gallery} />
  </section>

  <section class="container vp-main">
    <div class="vp-content">
      <ul class="vp-facts">
        {v.keyFacts.map((f) => <li><small>{f.label}</small><strong>{f.value}</strong></li>)}
      </ul>

      <p class="vp-tldr"><strong>En resumen:</strong> alquila la {v.name} ({v.type.toLowerCase()}) en Sevilla desde <span data-from={v.id}>{fromPrice(v)}</span> €/día, con recogida en Salteras, mínimo {pricing.minDays} días, seguro y asistencia 24 h incluidos y carnet B. Ideal para {v.idealFor.charAt(0).toLowerCase() + v.idealFor.slice(1)}.</p>

      <div class="prose">
        <slot />
      </div>

      <h2>Lo mejor de la {v.short}</h2>
      <ul class="check-list vp-hl">{v.highlights.map((h) => <li>{h}</li>)}</ul>

      <h2>Equipamiento</h2>
      <div class="vp-eq">
        {v.equipment.map((g) => (
          <div><h3>{g.group}</h3><ul class="check-list">{g.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>

      <h2 id="disponibilidad">Disponibilidad de la {v.short}</h2>
      <p>Los días en verde están libres. Selecciona recogida y devolución para pedir tu precio.</p>
      <AvailabilityCalendar vehicle={v} />
      <p class="vp-calmore"><a href={v.calSlug}><Icon name="calendar" /> Ver el calendario completo de la {v.short}, con precio por día y 4 meses a la vista</a></p>

      <h2 id="precios">Precios de alquiler de la {v.short}</h2>
      <PriceTable only={v.id} />
    </div>

    <aside class="vp-aside">
      <div class="vp-sticky">
        <div class="vp-price">
          <p><small>Alquiler desde</small><strong><span data-from={v.id}>{fromPrice(v)}</span> €<span class="vp-unit">/día</span></strong></p>
          <div class="vp-note"><PriceNote compact /></div>
          <a class="btn btn--wa" href={waLink(`Hola, me interesa alquilar la ${v.name}. ¿Tenéis disponibilidad para…?`)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
          <a class="btn btn--ghost" href={`tel:${site.phone}`}><Icon name="phone" /> {site.phoneDisplay}</a>
        </div>
        <QuoteForm preselect={v.id} title={`Reserva la ${v.short}`} />
      </div>
    </aside>
  </section>

  <section class="section section--sand">
    <div class="narrow">
      <h2>Preguntas sobre la {v.short}</h2>
      <FaqList items={faqs} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Alternativa</span><h2>¿Prefieres otro modelo?</h2></div>
      <div style="max-width:600px"><VehicleCard vehicle={other} /></div>
    </div>
  </section>

  <Location />
</Base>
<style>
  .vp-hero { padding: 1.5rem 0 2rem; }
  .vp-hero__head { max-width: 820px; margin-bottom: 1.5rem; }
  .vp-hero__head .lead { margin: 0; }
  .vp-main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: 3rem; padding-bottom: 4rem; }
  .vp-content h2 { margin-top: 2.6rem; }
  .vp-tldr { margin: 0 0 1.8rem; padding: .2rem 0 .2rem 1.1rem; border-left: 3px solid var(--terra); font-size: 1.02rem; }
  .vp-tldr strong { color: var(--forest); }
  .vp-facts { list-style: none; padding: 1.1rem 0; margin: 0 0 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 1rem 0; border-block: 1px solid var(--line); }
  .vp-facts li { display: grid; gap: .15rem; padding: 0 1rem; border-left: 1px solid var(--line); }
  .vp-facts li:first-child { border-left: 0; padding-left: 0; }
  .vp-facts small { font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .vp-facts strong { font-family: var(--display); font-size: 1.25rem; color: var(--ink); }
  .vp-hl { grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .vp-eq { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 1.5rem 2rem; }
  .vp-eq > div { border-top: 2px solid var(--line); padding-top: 1rem; }
  .vp-eq h3 { font-size: 1.1rem; }
  .vp-eq .check-list { font-size: .93rem; }
  .vp-sticky { position: sticky; top: 92px; display: grid; gap: 1rem; }
  .vp-price { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; background: #fff; color: var(--ink); padding: 1.3rem; border-radius: var(--radius); box-shadow: var(--shadow); }
  .vp-price p { grid-column: 1 / -1; margin: 0; display: flex; align-items: baseline; gap: .4rem; }
  .vp-price small { color: var(--muted); }
  .vp-price strong { font-family: var(--display); font-size: 2.6rem; color: var(--price); line-height: 1.1; letter-spacing: -.02em; }
  .vp-unit { font-size: .5em; font-weight: 500; margin-left: .1em; }
  .vp-note { grid-column: 1 / -1; margin: -.3rem 0 .3rem; }
  .vp-price .btn { padding: .75em .6em; font-size: .92rem; white-space: normal; min-width: 0; }
  @media (max-width: 1020px) {
    .vp-main { grid-template-columns: minmax(0, 1fr); }
    .vp-sticky { position: static; }
  }
  .vp-calmore { margin-top: 1rem; }
  .vp-calmore a { display: inline-flex; gap: .45rem; align-items: center; font-weight: 600; color: var(--forest); }
  .vp-calmore :global(svg) { width: 18px; height: 18px; color: var(--forest); flex: none; }
</style>
